language 0.1

//  The pencil, as the shell draws it: the building blocks of a Vitreus add-on's panel. Import this next to addon-palette.plm and read STYLE.md first.
//
//  What it expects of the scene that imports it (it reads them as the scene's own names, like the palette's colours):
//    let u = 1.1                                              // the panel's unit: size every length as N * u
//    let fr = if(shown > 0.5, floor(time * 8), 0)             // which redrawing of the lines this is: the pencil rests while the panel is shut
//  A component takes `f` (the frame its lines are drawn on): leave it out and they redraw about eight times a second; pass `0` and they rest, still crooked. The shell's rule,
//  and ours: a piece of drawing rests unless it is on or under the pointer (`f: if(on or hover, fr, 0)`).
//
//    PLn, PCir, PRound   a stroke, a ring and a rounded box in pencil (each drawn twice, the second a hair off and fainter)
//    PSwitch, PFill      the Control Center's pill switch, and the fill that rises from it into its card
//    PSliderCC           the shell's own slider as the Control Center draws it (calm at rest, a smooth ring for the knob): prefer it to PSlider for a look that matches
//    PSlider, PSliderMini the Control Center's slider (a pill track, the level coloured in with pencil columns, a ring for a knob), and a smaller one for the foot of a card;
//                        PSliderTint and PSliderMiniTint take the pencil's colour too (a light in its own colour)
//    PIcon               nine icons (0 bulb, 1 lamp, 2 power, 3 moon, 4 fan, 5 TV, 6 plug, 7 door, 8 house) drawn from one shared set of strokes: draw your own set the same way
//                        (a table of strokes looked up with `pick(k, …)`) rather than one drawing per icon: every drawing is instantiated once for every copy of a model, and a scene
//                        may hold only 65 536 properties.

library Pencil {
    //  ── the pencil ──
    //  A line: drawn twice, the second a hair off, thinner and fainter. `s` is the line's own seed, so no two wobble together.
    component PLn(ax: number, ay: number, bx: number, by: number, s: number, wd: number, c: color, a: number, f: number = fr, j: number = 1) {
        line { from: ax + 0.5 * j * u * sin(f * 61 + s * 50), ay + 0.5 * j * u * sin(f * 67 + s * 30); to: bx + 0.5 * j * u * sin(f * 53 + s * 70), by + 0.5 * j * u * sin(f * 59 + s * 90); width: wd; color: c; opacity: a }
        line { from: ax + 0.9 * j * u + 0.5 * j * u * sin(f * 47 + s * 70), ay - 0.6 * j * u + 0.5 * j * u * sin(f * 43 + s * 110); to: bx - 0.5 * j * u + 0.5 * j * u * sin(f * 41 + s * 30), by + 0.7 * j * u + 0.5 * j * u * sin(f * 37 + s * 50); width: wd * 0.6; color: c; opacity: a * 0.35 * j }
    }
    //  A circle: strokes of an uneven ring, round twice. `gapk` leaves one stroke out (the power sign's break); -1 closes it.
    component PCir(cx: number, cy: number, rad: number, s: number, wd: number, c: color, a: number, gapk: number, f: number = fr, j: number = 1) {
        repeat k in 0..10 {
            let a0 = k * 36 + 6
            let a1 = a0 + 40
            let r0 = rad * (1 + 0.06 * j * sin(f * 53 + k * 97 + s * 40))
            let r1 = rad * (1 + 0.06 * j * sin(f * 53 + (k + 1) * 97 + s * 40))
            line { from: cx + r0 * cos(a0), cy + r0 * sin(a0); to: cx + r1 * cos(a1), cy + r1 * sin(a1); width: wd; color: c; opacity: if(k == gapk, 0, a) }
        }
        repeat k in 0..7 {
            let b0 = k * 51 + 90
            let b1 = b0 + 56
            let q0 = rad * 0.92 * (1 + 0.07 * j * sin(f * 41 + k * 131 + s * 60))
            let q1 = rad * 0.92 * (1 + 0.07 * j * sin(f * 41 + (k + 1) * 131 + s * 60))
            line { from: cx + 0.9 * j * u + q0 * cos(b0), cy - 0.6 * j * u + q0 * sin(b0); to: cx + 0.9 * j * u + q1 * cos(b1), cy - 0.6 * j * u + q1 * sin(b1); width: wd * 0.65; color: c; opacity: a * 0.32 * j }
        }
    }
    //  A rounded rectangle in one wavering stroke, and a faint second one inside it.
    component PRound(x: number, y: number, w: number, h: number, r: number, s: number, wd: number, c: color, a: number, f: number = fr) {
        path { at: x, y; stroke: wd; color: c; opacity: a
            move r, 0.7 * u * sin(f * 53 + s * 97)
            line w - r, 0.7 * u * sin(f * 47 + s * 61)
            curve w + 0.4 * u * sin(f * 43 + s * 17), r via w + 0.5 * u * sin(f * 59 + s), 0.5 * u * sin(f * 61 + s)
            line w + 0.6 * u * sin(f * 41 + s * 23), h - r
            curve w - r, h + 0.5 * u * sin(f * 37 + s * 29) via w, h
            line r, h + 0.7 * u * sin(f * 51 + s * 31)
            curve 0.5 * u * sin(f * 49 + s * 13), h - r via 0, h
            line 0.6 * u * sin(f * 57 + s * 19), r
            curve r + 1.4 * u, 0.4 * u * sin(f * 45 + s * 7) via 0, 0
        }
        path { at: x + 0.9 * u, y - 0.6 * u; stroke: wd * 0.6; color: c; opacity: a * 0.3
            move r, 0.7 * u * sin(f * 41 + s * 77)
            line w - r, 0.7 * u * sin(f * 37 + s * 43)
            curve w + 0.5 * u * sin(f * 33 + s * 11), r via w, 0
            line w + 0.5 * u * sin(f * 31 + s * 53), h - r
            curve w - r, h via w, h
            line r, h + 0.6 * u * sin(f * 39 + s * 71)
        }
    }

    //  The pill switch every tile carries, as the Control Center's toggles: a knob that slides to the end and stretches like liquid on the way (`m`, how much it is moving: 0 at rest, 1 half way),
    //  the track going from grey to the accent. It only shows the state; the whole tile is the button. `a` follows `on` in each copy's own spring.
    component PSwitch(sx: number, sy: number, on: number, av: number, s: number, f: number = fr) {
        prop a = 0 ~calm
        follow a = on
        let m = clamp(4 * a * (1 - a), 0, 1)
        let sw = (34 + 4 * a) * u                                 // narrower off, wider on, with its right end where it was
        let scx = sx + 19 * u - sw / 2
        let sl = scx - sw / 2
        let kx = sl + 11 * u + a * (sw - 22 * u)
        //  The track: a dark hollow off, raised and lit from inside on.
        body {
            color: mix(off, mint, a)
            opacity: av
            shadow: 0, 0, 10 * u * a, 48% * a, mint
            rim: 16% * a
            box { at: scx, sy; size: sw, 22 * u; corner: (11 - 2 * a) * u }
        }
        group {
            clip inset 0 box { at: scx, sy; size: sw, 22 * u; corner: (11 - 2 * a) * u }
            box { from: sl - 6 * u, sy - 11 * u; size: sw + 12 * u, 6 * u; color: #000000; opacity: 26% * (1 - a) * av }
            box { from: sl, sy + 9.5 * u; size: sw, 1.5 * u; color: ink; opacity: 12% * (1 - a) * av }
        }
        PRound(x: sl, y: sy - 11 * u, w: sw, h: 22 * u, r: (11 - 2 * a) * u, s: s, wd: 1.1 * u, c: mix(faint, mint, a), a: 0.7 * av, f: f)
        //  The knob: plain and solid, a circle off and a rounded square on, stretching as it goes.
        body {
            color: ink
            opacity: av
            shadow: 0, 2 * u, 5 * u, 26%
            box { at: kx, sy; size: (17 + 9 * m) * u, (17 - 3 * m) * u; corner: (8.5 - 2 * a - 1.5 * m) * u }
        }
    }
    //  The tile fills up from its switch when it turns on (and drains back into it when it turns off), clipped to the tile.
    component PFill(tx: number, ty: number, tw: number, th: number, sx: number, sy: number, on: number, av: number) {
        prop a = 0 ~calm
        follow a = on
        group {
            clip inset 0 box { from: tx, ty; size: tw, th; corner: 12 * u }
            ellipse { at: sx, sy; radius: a * (tw + th) * 0.9 + 0.01; color: mint; opacity: 16% * av }
        }
    }

    //  The slider, as the Control Center's PSlider: a pill-shaped track in a crooked double outline, the level coloured in with the pencil (tight columns up and down, the second pass fainter and a hair
    //  off), and a ring for a knob, drawn twice and bigger than the track is thick. `lv` is 0 to 1, `h` the track's thickness; it rests unless `f` (the frame) is the scene's.
    //  The level is pencilled in the accent; PSliderTint takes the colour (`c`) instead, for a slider that stands for something with a colour of its own (a light).
    component PSlider(x0: number, y: number, w: number, lv: number, h: number, f: number) {
        PSliderTint(x0, y, w, lv, h, f, mint)
    }
    component PSliderTint(x0: number, y: number, w: number, lv: number, h: number, f: number, c: color) {
        let kx = clamp(x0 + w * lv, x0 + h * 0.6, x0 + w - h * 0.6)
        let xs = x0 + h * 0.5
        let xe = max(x0 + w * lv - h * 0.1, xs)
        let sp = max(2.5 * u, (w - h) / 39)
        PRound(x: x0, y: y - h / 2, w: w, h: h, r: h / 2, s: 81, wd: 1.5 * u, c: ink, a: 0.65, f: f)
        repeat i in 0..40 {
            let cxi = xs + i * sp
            PLn(ax: cxi + h * 0.1, ay: y - h * 0.38, bx: cxi - h * 0.1, by: y + h * 0.38, s: 200 + i, wd: 1.1 * u, c: c, a: if(cxi < xe, 0.62, 0), f: f)
        }
        ellipse { at: kx, y; radius: h * 0.85; color: ink; opacity: 14% }
        PCir(cx: kx, cy: y, rad: h * 0.85, s: 83, wd: 1.5 * u, c: ink, a: 0.9, gapk: -1, f: f)
    }
    //  The shell's own slider (the Control Center's volume), copied as it is: calm at rest, redrawn about five times a second under the pointer (`hot`), a smooth ring for the knob.
    component PSliderCC(x0: number, y: number, w: number, lv: number, hot: number, k: number, h: number, mute: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jt = (0.18 + 0.25 * a) * u
        let kx = clamp(x0 + w * lv, x0 + h * 0.6, x0 + w - h * 0.6)
        let sp = max(2.5 * k, (w - h) / 86)           // the 88 columns of pencil reach the end of any track: the control center's are as close as they were, a longer one spreads them
        path { at: 0, 0; stroke: 1.5 * k; color: ink; opacity: 0.6; move x0 + h / 2 + jt * sin(fr * 57 + 15900), y - h / 2 + jt * sin(fr * 62 + 15960); line x0 + w - h / 2 + jt * sin(fr * 64 + 15997), y - h / 2 + jt * sin(fr * 69 + 16057); curve x0 + w + jt * sin(fr * 71 + 16094), y + jt * sin(fr * 76 + 16154) via x0 + w + jt * sin(fr * 72 + 19974), y - h / 2 + jt * sin(fr * 77 + 20034); curve x0 + w - h / 2 + jt * sin(fr * 47 + 16191), y + h / 2 + jt * sin(fr * 52 + 16251) via x0 + w + jt * sin(fr * 48 + 20071), y + h / 2 + jt * sin(fr * 53 + 20131); line x0 + h / 2 + jt * sin(fr * 54 + 16288), y + h / 2 + jt * sin(fr * 59 + 16348); curve x0 + jt * sin(fr * 61 + 16385), y + jt * sin(fr * 66 + 16445) via x0 + jt * sin(fr * 62 + 20265), y + h / 2 + jt * sin(fr * 67 + 20325); curve x0 + h / 2 + jt * sin(fr * 68 + 16482), y - h / 2 + jt * sin(fr * 73 + 16542) via x0 + jt * sin(fr * 69 + 20362), y - h / 2 + jt * sin(fr * 74 + 20422); }
        path { at: 0 + 0.35 * u, 0 + 0.28 * u; stroke: 1.05 * k; color: ink; opacity: 0.2; move x0 + h / 2 + jt * sin(fr * 72 + 16271), y - h / 2 + jt * sin(fr * 77 + 16331); line x0 + w - h / 2 + jt * sin(fr * 48 + 16368), y - h / 2 + jt * sin(fr * 53 + 16428); curve x0 + w + jt * sin(fr * 55 + 16465), y + jt * sin(fr * 60 + 16525) via x0 + w + jt * sin(fr * 56 + 20345), y - h / 2 + jt * sin(fr * 61 + 20405); curve x0 + w - h / 2 + jt * sin(fr * 62 + 16562), y + h / 2 + jt * sin(fr * 67 + 16622) via x0 + w + jt * sin(fr * 63 + 20442), y + h / 2 + jt * sin(fr * 68 + 20502); line x0 + h / 2 + jt * sin(fr * 69 + 16659), y + h / 2 + jt * sin(fr * 74 + 16719); curve x0 + jt * sin(fr * 45 + 16756), y + jt * sin(fr * 50 + 16816) via x0 + jt * sin(fr * 46 + 20636), y + h / 2 + jt * sin(fr * 51 + 20696); curve x0 + h / 2 + jt * sin(fr * 52 + 16853), y - h / 2 + jt * sin(fr * 57 + 16913) via x0 + jt * sin(fr * 53 + 20733), y - h / 2 + jt * sin(fr * 58 + 20793); }
        //  The shading: the level coloured in with a pencil, in tight columns up and down (one shape, the second pass fainter and a hair off). Each stroke leans, wobbles and overshoots a little;
        //  the columns past the level fold onto its end (they add nothing), and with none of it there is nothing to draw. (A path has at most 191 steps: 88 columns of two.)
        let xs = x0 + h * 0.5
        let xe = max(x0 + w * lv - h * 0.1, xs)
        path { at: 0, 0; stroke: 1.1 * k; color: mix(mint, faint, mute); opacity: 0.5 * (1 - 0.55 * mute) * clamp(lv * 40, 0, 1); move min(xs + 0 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(0) + jt * sin(fr * 49 + 18550), y + h * -0.38 + h * 0.05 * sin(0) + jt * sin(fr * 54 + 18610); line min(xs + 0 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(41) + jt * sin(fr * 56 + 18647), y + h * 0.38 + h * 0.05 * sin(73) + jt * sin(fr * 61 + 18707); line min(xs + 1 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(67) + jt * sin(fr * 63 + 18744), y + h * 0.38 + h * 0.05 * sin(29) + jt * sin(fr * 68 + 18804); line min(xs + 1 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(108) + jt * sin(fr * 70 + 18841), y + h * -0.38 + h * 0.05 * sin(102) + jt * sin(fr * 75 + 18901); line min(xs + 2 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(134) + jt * sin(fr * 46 + 18938), y + h * -0.38 + h * 0.05 * sin(58) + jt * sin(fr * 51 + 18998); line min(xs + 2 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(175) + jt * sin(fr * 53 + 19035), y + h * 0.38 + h * 0.05 * sin(131) + jt * sin(fr * 58 + 19095); line min(xs + 3 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(201) + jt * sin(fr * 60 + 19132), y + h * 0.38 + h * 0.05 * sin(87) + jt * sin(fr * 65 + 19192); line min(xs + 3 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(242) + jt * sin(fr * 67 + 19229), y + h * -0.38 + h * 0.05 * sin(160) + jt * sin(fr * 72 + 19289); line min(xs + 4 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(268) + jt * sin(fr * 43 + 19326), y + h * -0.38 + h * 0.05 * sin(116) + jt * sin(fr * 48 + 19386); line min(xs + 4 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(309) + jt * sin(fr * 50 + 19423), y + h * 0.38 + h * 0.05 * sin(189) + jt * sin(fr * 55 + 19483); line min(xs + 5 * sp, xe) + h * 0.1 * -1 + h * 0.02 * sin(335) + jt * sin(fr * 57 + 19520), y + h * 0.38 + h * 0.05 * sin(145) + jt * sin(fr * 62 + 19580); line min(xs + 5 * sp, xe) + h * 0.1 * 1 + h * 0.02 * sin(376) + jt * sin(fr * 64 + 19617), y + h * -0.38 + h * 0.05 * sin(218) + jt * sin(fr * 69 + 19677); line min