language 0.1
import "addon-palette.plm"
import "addon-theme.plm"                          // the theme's own pieces (PThumb: the lit tab under the Apple TV card's chosen tab)
import "ha-icons.plm"                             // the add-on's own icons in the same pencil (HUi: the buttons; HDev: its device icons), made by tools/icons.py
import "addon-pencil.plm"                         // Vitreus's pencil (its add-on template): the sliders are drawn with it, as the Control Center's

//  Home Assistant, as a Vitreus add-on with a panel: the rooms listed in config.json (the scene's data folder, ~/.local/share/pleamar/homeassistant/),
//  each with its name, its temperature and humidity if it has sensors for them, and a tile for each of its lights and switches, drawn in the shell's own
//  manner (the control centre's tiles: a veil, a lit disc, Space Grotesk). A click toggles a tile; a right click on a light opens its brightness slider
//  over the panel (and its colour, for a light with "color": true in config.json); on a printer, its card; on an Apple TV, its card with what plays and
//  a remote. The pencil puts the tiles in edit mode: each gets a handle in its corner that pulls it wider or taller, cell by cell.
//  homeassistant.luau talks to Home Assistant's REST API with curl (the token goes in a file curl reads, never in its arguments), lays the tiles out
//  (`col`, `cs`, `rs`, `yu`: where each goes and how big, in cells and unscaled pixels) and fills `hl_items` and `hl_rooms`.
//  Every icon is drawn in Vitreus's pencil: a tile's "icon" names one by its Material Symbols name ("lightbulb", "tv", "bedtime"…), which picks the closest of the
//  pencil's (addon-pencil.plm's PIcon) or of the add-on's own (ha-icons.plm's HDev); the buttons are ha-icons.plm's HUi.

scene HomeAssistant {
    surface { size: full, full; anchor: top_left; margin: 0; level: top, overlay while slot_open; screens: each max 4; keyboard: exclusive while tv_open and tv_tab == 1 and shown > 0.5 }

    permissions {
        services: "files", "files.write", "env"
        run: "curl", "xdg-terminal-exec", "xdg-open", "vitreus-edit", "wl-copy", "pleamar"
    }

    fact pal_ink_r = 0.9608
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667
    fact look = 0

    fact slot_open = false
    fact slot_x = 0
    fact slot_y = 0
    fact slot_w = 0
    fact slot_h = 0
    fact slot_sw = 0                                  // the size of the monitor the panel is on (0: not told yet, every copy draws)
    fact slot_sh = 0
    text slot_mon = ""                                // the name of that monitor (DP-1...), which Vitreus sends before `slot_open`
    //  Which copy draws: the one on the monitor Vitreus names (`slot_mon`; a scene cannot compare a text, so the logic finds the copy whose `screen.K.name`
    //  it is, `hl_mon`). -1: no copy has that name (an older Vitreus does not send it), and the monitor's size decides, as before.
    fact hl_mon = -1
    let by_size = if(slot_sw == 0 or (screen.width == slot_sw and screen.height == slot_sh), 1, 0)
    let shown = if(slot_open, if(hl_mon >= 0, if(screen.index == hl_mon, 1, 0), if(hl_mon == -1, by_size, 0)), 0)

    //  What the logic says (homeassistant.luau)
    fact hl_demo = false                              // no token in config.json yet: the example's rooms, played with here, and a banner on how to set it up
    text t_demo_title = ""
    text t_demo_hint = ""
    fact sl_dk = -1                                   // (the same for the add-on's own icons)
    fact pr_dk = -1
    fact tv_dk = -1
    fact sl_pk = 0                                    // the cards' pencil icons (from the tile that opened them)
    fact pr_pk = 6
    fact tv_pk = 5
    fact hl_state = 0                                 // 0 connecting · 1 connected · 2 an error (hl_msg says it) · 3 not set up yet
    text hl_status = "Conectando…"
    //  What the panel says: every word comes from the logic's table (`STR` in homeassistant.luau), in the language config.json asks for. A new language is a
    //  new block there; nothing here changes.
    text t_hint = ""                                  // edit mode's hint, in the head
    text t_ed = ""                                    // the pencil's name: what pressing it does now
    text t_refresh = ""
    text t_noed = ""                                  // the gear found no text editor: what to do, for a few seconds in the head (`hl_noed`)
    //  ── Settings: the gear opens them over the panel. Two tabs: the add-on's settings (the address, the token, the language, two switches) and its entities (the rooms
    //  and their tiles, each opened to edit, and a button to add one). What is shown is laid out by the logic (settings.luau) as rows: `st_rows` (a section's title, a
    //  field, a switch, a note, a suggestion, a button), `st_chips` (a choice among a few), `st_icons` (the icon grid) and `st_ents` (the entities' list), each with its
    //  place (unscaled, from the top of the scrolling list). A field is typed through the shell, as the add-on template's is: the logic tells the shell where the field
    //  is (the pointer over a field puts it there, so a click on it goes to the shell), and the shell sends back what is written (`field_q`) and Enter and Escape.
    fact st_open = false
    prop st_k = 0 ~240ms
    follow st_k = if(st_open, 1, 0)
    fact st_tab = 0                                   // 0 the settings · 1 the entities
    prop st_tk = 0 ~quick
    follow st_tk = st_tab
    fact st_page = 0                                  // 0 the tabs · 1 an entity being edited · 2 a room being edited
    text st_title = ""                                // the page's title, while one is being edited
    fact st_content = 0                               // how tall the list is, unscaled
    fact st_sc = 0
    //  The page's list scrolls by itself (`st_sp`), as the tiles' does, and not as a `view:` layout: a named layout is a zone as big as itself, and a zone of the
    //  add-on's over the shell's field keeps the click from it (the field seemed dead). Its zones under the rows take the wheel everywhere but over the placed
    //  field, where nothing of the add-on's is left.
    prop st_sp = 0 ~quick
    on change st_sp { st_sc = st_sp }
    on change st_page { st_sp: 0 }                   // (a page opens at its top)
    on change st_tab { st_sp: 0 }
    model st_rows max 30 { kind: number; label: text; val: text; ph: text; sub: text; x: number; y: number; w: number; h: number; on: number; tone: number }
    model st_sws max 8 { label: text; y: number; on: number }      // the switches (their own model: a switch is a heavy drawing, and few rows are one)
    //  kind: 0 a section's title · 1 a field (label, value or placeholder; `on` 1: it has a value) · 4 a note · 5 a suggestion (label, sub) · 6 a button (`tone`: 0 plain,
    //  1 the accent, 2 danger, 3 danger armed: pressed once, asking again)
    model st_chips max 24 { label: text; x: number; y: number; w: number; sel: number }
    model st_icons max 18 { pk: number; dk: number; x: number; y: number; sel: number }
    model st_ents max 44 { kind: number; name: text; sub: text; pk: number; y: number }      // kind 0 a room · 1 a tile
    fact st_fa = -1                                   // the field the shell's field is on (a row of st_rows), where it is, and what it says (masked for the token)
    fact st_fx = 0
    fact st_fy = 0
    fact st_fw = 0
    text st_fv = ""
    fact st_fvon = false
    measure stf
    text t_st_settings = ""
    text t_st_entities = ""
    text t_st_back = ""
    event st_do ->                                    // a row of st_rows pressed (a switch, a suggestion, a button)
    event st_fld ->                                   // a field wanted: the shell's field goes there
    event st_sw ->                                    // a switch flipped
    event st_chip ->
    event st_icon ->
    event st_ent ->                                   // an entry of the entities' list: open it
    event st_back ->                                  // back from an entity or a room to the list
    text field_q = ""                                 // what the shell's field says, whether it is being typed in, and its Enter and Escape
    fact field_kb = false
    event field_enter ->
    event field_esc ->
    fact hl_noed = false
    prop hl_ne = 0 ~calm
    follow hl_ne = if(hl_noed, 1, 0)
    text t_edit_cfg = ""                              // the gear's name, and the button of the panel that is not set up
    text t_connecting = ""
    text t_title = ""                                 // the empty panel's title: it cannot connect, or it is not set up
    text t_empty = ""
    text t_empty_hint = ""
    text t_brightness = ""
    text t_close = ""
    text t_off = ""
    text t_resize = ""                                // "Resize" in "Resize Lamp", a handle's name
    text hl_msg = ""
    model hl_items max 32 { name: text; icon: text; sub: text; on: number; kind: number; bri: number; avail: number; col: number; cs: number; rs: number; yu: number; img: image 48, 48; custom: number; prn: number; pp: number; cc: number; hk: number; hu: number; sa: number; tvr: number; pk: number; dk: number; ct: number }      // `dk` which of the add-on's own icons it is, in pencil (HDev; -1 none) · `pk` the pencil icon it is drawn with (addon-pencil.plm's PIcon: 0 bulb … 8 house), -1: a picture of its own · `tvr` 1: an Apple TV (or another player) with a card of its own (right click) · `cc` 1: a light whose colour is chosen here (config.json's "color") · `ct` 1: one drawn in its own colour rather than the accent ("tint") · `hk` 1: its colour is known, `hu` its hue and `sa` its saturation (0 to 1) · kind 0 a light, 1 a switch · `prn` 1: it has a printer's card (right click) · `pp` the print's progress while one runs (-1 none) · an icon of its own (an svg, `custom` 1) instead of a Material one · its column, how many columns and rows it takes, its top (unscaled)
    model hl_rooms max 12 { name: text; temp: text; hum: text; has_t: number; has_h: number; yu: number }      // a room's head: its name, and its sensors' readings if it has them
    fact hl_cols = 2                                  // how many columns the logic laid the tiles out in (from the panel's width)
    fact hl_content = 0                               // how tall it all is, unscaled
    event hl_tap ->                                   // a tile was clicked: its place
    event hl_bri ->                                   // the slider let go: the brightness, 0 to 1 (`sl_i` says which light)
    event hl_refresh ->
    event hl_edit ->                                  // open config.json in an editor
    event hl_resize ->                                // a tile pulled to a new size (`rz_w` by `rz_h` cells): its place
    //  Edit mode: the tiles are not pressed but resized, by the handle in their corner
    fact hl_editing = false
    prop hl_ed = 0 ~quick
    follow hl_ed = if(hl_editing, 1, 0)
    fact rz_i = -1                                    // the tile being resized, and its size when it was taken and now, in cells
    fact rz_w0 = 1
    fact rz_h0 = 1
    fact rz_w = 1
    fact rz_h = 1
    on change rz_w while rz_i >= 0 { emit hl_resize(rz_i) }
    on change rz_h while rz_i >= 0 { emit hl_resize(rz_i) }

    //  The brightness slider, over the panel
    fact sl_open = false
    fact sl_i = -1
    fact sl_v = 0
    fact sl_dirty = false                             // moved since it was last sent
    text sl_name = ""
    text sl_icon = "lightbulb"
    fact sl_custom = false                            // the light's icon is an svg of its own (drawn from its record, below)
    //  its colour, for a light that has one: a hue and a saturation, 0 to 1 (Home Assistant's hs_color), chosen on a rainbow or among a few made ones
    fact sl_col = 0                                   // 1: this light's colour is chosen here
    fact sl_tint = 0                                  // 1: the card is drawn in the light's colour (its tile is too), not the accent
    fact sl_ck = 0                                    // 1: its colour is known (until then the card and the tile keep the accent)
    fact sl_h = 0
    fact sl_s = 0
    fact sl_cdirty = false
    prop sl_hs = 0 ~quick
    follow sl_hs = sl_h
    prop sl_ss = 0 ~quick
    follow sl_ss = sl_s
    event hl_color ->                                 // a colour chosen: its hue in degrees times 1000, plus its saturation in percent (`sl_i` says which light)
    text t_color = ""

    //  The printer's card: a tile with "printer" in config.json opens it with a right click (a click still toggles the tile). The logic fills it from the printer's
    //  sensors: the job, its state, its progress, the time left, when it started and ends, the model's cover or the camera, and its buttons.
    fact pr_open = false
    fact pr_i = -1
    prop pr_k = 0 ~240ms
    follow pr_k = if(pr_open, 1, 0)
    fact pr_st = 0                                    // 0 waiting · 1 printing · 2 paused · 3 finished · 4 failed · 5 preparing · 6 offline
    fact pr_prog = 0
    prop pr_progs = 0 ~calm
    follow pr_progs = pr_prog
    text pr_icon = "print"
    fact pr_custom = false
    text pr_task = ""
    text pr_status = ""
    text pr_pct = ""
    text pr_left = ""
    text pr_start = ""
    text pr_end = ""
    fact pr_has_pic = false                           // a picture to show: the model's cover, or the camera
    fact pr_has_cam = false
    fact pr_has_btn = false                           // pause, resume and stop are configured
    fact pr_cam = false                               // the camera instead of the cover
    fact pr_arm = false                               // stop pressed once: a second press within three seconds stops the print
    model pr_pic max 1 { img: image 512, 512 }
    event pr_act ->                                   // 0 pause · 1 resume · 2 stop · 4 the camera, full size, in the browser
    on change pr_open while not pr_open { pr_cam = false; pr_arm = false }
    on still pr_arm for 3000ms while pr_arm { pr_arm = false }
    text t_progress = ""
    text t_pause = ""
    text t_resume = ""
    text t_stop = ""
    text t_stop_sure = ""
    text t_camera = ""
    text t_live = ""
    text t_open_cam = ""
    text t_b0 = ""                                    // the card's buttons' words, now (the logic: pause or resume, stop or "stop?", camera), and how wide each is
    text t_b1 = ""
    text t_b2 = ""
    measure pbm.0
    measure pbm.1
    measure pbm.2
    measure tbm.0
    measure tbm.1
    //  An Apple TV's card: a tile with "apple_tv" in config.json opens it with a right click. Two tabs: what is playing (its artwork, its title, how far it
    //  has got, and the transport buttons) and a remote like the Siri Remote's (the clickpad, back, TV, play/pause and the volume), which the keyboard
    //  drives too while it is showing (the arrows, Return, BackSpace for back, the space bar for play/pause; Escape shuts the card).
    fact tv_open = false
    fact tv_i = -1
    fact tv_tab = 0                                   // 0 what is playing · 1 the remote
    prop tv_k = 0 ~240ms
    follow tv_k = if(tv_open, 1, 0)
    prop tv_tk = 0 ~quick
    follow tv_tk = tv_tab
    fact tv_st = 0                                    // 0 off · 1 on, nothing playing · 2 playing · 3 paused
    fact tv_prog = 0
    prop tv_progs = 0 ~calm
    follow tv_progs = tv_prog
    fact tv_has_prog = false                          // it says how long what plays is, and how far it has got
    fact tv_has_pic = false
    fact tv_has_rm = false                            // a remote entity is configured: the remote's tab
    fact tv_custom = false
    text tv_icon = "tv"
    text tv_name = ""
    text tv_status = ""
    text tv_title = ""
    text tv_sub = ""
    text tv_app = ""                                  // the app it is in (Netflix, Crunchyroll…), for the artwork's place when there is none
    fact tv_app_on = false
    fact tv_has_appic = false                         // no artwork, but the app's icon (looked up by the logic)
    model tv_appic max 1 { img: image 256, 256 }
    text tv_pos = ""
    text tv_rem = ""
    model tv_pic max 1 { img: image 512, 512 }
    //  what a button asks for: 0 up · 1 down · 2 left · 3 right · 4 select · 5 back · 6 TV (home) · 7 play/pause · 8 volume up · 9 volume down · 10 power
    //  · 11 previous · 12 next · 15 select held · 16 TV held · 17 mute
    event tv_cmd ->
    fact tv_fl = -1                                   // the button just pressed, lit for a moment (a key presses it too)
    on still tv_fl for 180ms while tv_fl >= 0 { tv_fl = -1 }
    fact tv_hd = false                                // held: its release sends nothing more
    on change tv_open while not tv_open { tv_tab = 0 }
    text t_tab0 = ""
    text t_tab1 = ""
    text t_kb = ""
    text t_power = ""
    text t_up = ""                                    // the buttons' names, for whoever reads them out
    text t_down = ""
    text t_left = ""
    text t_right = ""
    text t_select = ""
    text t_back = ""
    text t_home = ""
    text t_playpause = ""
    text t_volup = ""
    text t_voldown = ""
    text t_mute = ""
    text t_prev = ""
    text t_next = ""
    prop sl_k = 0 ~240ms
    follow sl_k = if(sl_open, 1, 0)
    prop sl_vs = 0 ~quick                             // the fill, a hair behind the finger
    follow sl_vs = sl_v

    fact hl_sc = 0                                    // how far the list has scrolled, for what is inside it (a layout cannot read its own `scroll` from within)
    //  The tiles' list scrolls by itself (`hl_sp`): the wheel, and a drag that starts on it, except in edit mode, where a drag pulls a tile's corner or carries a
    //  tile (a layout with `view:` scrolls with any drag that starts on it, so pulling a corner scrolled the list).
    prop hl_sp = 0 ~quick
    fact hl_grab = 0
    on change hl_sp { hl_sc = hl_sp }
    //  Edit mode: a tile carried to another place (`mv_i`), how far it has gone, and where its middle is now (the tile under it is where it lands)
    fact mv_i = -1
    fact mv_dx = 0
    fact mv_dy = 0
    fact mv_cx = 0
    fact mv_cy = 0
    event hl_move ->                                  // dropped: its place × 10 000 000 + where its middle is, x × 10 000 + y (unscaled, from the list's top left)
    text t_rz = ""                                    // the size a tile being pulled would take ("½ × 1", "2 × 1"…)
    prop hl_spin = 0
    spin hl_spin by if(hl_state == 0, 1, 0)

    let u = 1.1
    let fr = if(shown > 0.5 and look < 4.5, floor(time * 8), 0)       // which redrawing of the pencil this is (it holds still on the Proxy theme, whose HUD is crisp)
    //  The content arrives as the Control Center's does (the add-on template's recipe): the head, then the tiles, then the rest, each rising a little as it fades in, each
    //  on its own spring, starting 200 ms after the panel is out (a scene that was shut draws nothing, so its first frame is long and a spring started in it would be over
    //  at once); out at once. `wk` keeps frames coming while the content waits.
    prop wk = 0 ~700ms
    prop en1 = 0 ~200ms
    prop en2 = 0 ~380ms
    prop en3 = 0 ~520ms
    on change shown while shown > 0.5 { wk: 1; en1: 1 after 200ms; en2: 1 after 200ms; en3: 1 after 200ms }
    on change shown while shown < 0.5 { wk: 0 ~80ms; en1: 0 ~80ms; en2: 0 ~80ms; en3: 0 ~80ms; en1: 0 ~80ms after 205ms; en2: 0 ~80ms after 205ms; en3: 0 ~80ms after 205ms }
    every 500ms while shown > 0.5 and en1 < 0.002 { en1: 1 after 200ms; en2: 1 after 200ms; en3: 1 after 200ms }

    let W = max(slot_w, 1)
    let H = max(slot_h, 1)

    //  The grid: as many columns as fit at 170 apiece, up to four (the logic works them out, and lays the tiles in them); a cell is 74 tall
    let gx = 14 * u
    let gtop = (60 + if(hl_demo, 72, 0)) * u                  // (below the demo's banner, while there is one)
    let gap = 10 * u
    let cols = max(1, hl_cols)
    let tw = (W - 2 * gx - (cols - 1) * gap) / cols
    let hw = (tw - gap) / 2                            // half a column: the grid is laid out in halves (a tile takes one, an icon only, or two or more)
    let th = 74 * u
    let vh = max(H - gtop - 12 * u, 1)
    let content = hl_content * u
    let most = max(0, content - vh)
    on change most while hl_sp > most { hl_sp: most }


    group {
        show: shown > 0.5
        group {
            move: slot_x - W / 2, slot_y - H / 2

            group {
            opacity: en1
            move: 0, (1 - en1) * 12 * u
            //  ── the head: how it is, and the refresh arrow and the gear ──
            ellipse { at: 24 * u, 28 * u; radius: 4 * u; color: pick(hl_state, faint, mint, alert, faint) }
            ellipse { at: 24 * u, 28 * u; radius: 8 * u; color: mint; opacity: if(hl_state == 1, 18%, 0%) }
            text hl_status { at: 38 * u, 28 * u; anchor: left center; size: 12.5; weight: 600; width: W - 190 * u; lines: 1; color: faint; opacity: (1 - hl_ed) * (1 - hl_ne); family: "Space Grotesk" }
            text t_noed { at: 38 * u, 28 * u; anchor: left center; size: 11.5; weight: 600; width: W - 190 * u; lines: 2; color: alert; opacity: hl_ne * (1 - hl_ed); family: "Space Grotesk" }
            text t_hint { at: 38 * u, 28 * u; anchor: left center; size: 12.5; weight: 600; width: W - 190 * u; lines: 1; color: mint; opacity: hl_ed; family: "Space Grotesk" }

            //  the pencil: edit mode (lit, a tick, while it is on)
            body {
                color: mix(ink, mint, hl_ed)
                opacity: 8% + 10% * hl_ed_z.hover + 82% * hl_ed
                shadow: 0, 0, 10 * u * hl_ed, 35% * hl_ed, mint
                ellipse { at: W - 121 * u, 28 * u; radius: 16 * u }
            }
            HUi(k: if(hl_editing, 1, 0), cx: W - 121 * u, cy: 28 * u, c: mix(mix(ink, mint, hl_ed_z.hover), onmint, hl_ed), a: 1, s: 401, f: if(hl_ed_z.hover > 0.5, fr, 0), z: 0.73)
            zone box hl_ed_z { at: W - 121 * u, 28 * u; size: 34 * u, 34 * u; corner: 17 * u; cursor: pointer; label: t_ed; active: not st_open }
            on press hl_ed_z { toggle hl_editing; rz_i = -1 }

            ellipse { at: W - 37 * u, 28 * u; radius: 16 * u; color: ink; opacity: 8% + 10% * hl_rf_z.hover }
            HUi(k: 2, cx: W - 37 * u, cy: 28 * u, c: mix(ink, mint, hl_rf_z.hover), a: 1, s: 411, f: if(hl_rf_z.hover > 0.5, fr, 0), z: 0.75)
            zone box hl_rf_z { at: W - 37 * u, 28 * u; size: 34 * u, 34 * u; corner: 17 * u; cursor: pointer; label: t_refresh }
            on press hl_rf_z { emit hl_refresh }

            body {
                color: mix(ink, mint, st_k)
                opacity: 8% + 10% * hl_gear_z.hover + 82% * st_k
                shadow: 0, 0, 10 * u * st_k, 35% * st_k, mint
                ellipse { at: W - 79 * u, 28 * u; radius: 16 * u }
            }
            HUi(k: 3, cx: W - 79 * u, cy: 28 * u, c: mix(mix(ink, mint, hl_gear_z.hover), onmint, st_k), a: 1, s: 421, f: if(hl_gear_z.hover > 0.5, fr, 0), z: 0.7)
            zone box hl_gear_z { at: W - 79 * u, 28 * u; size: 34 * u, 34 * u; corner: 17 * u; cursor: pointer; label: t_edit_cfg }
            on press hl_gear_z { toggle st_open }

            box { at: W / 2, 50 * u; size: W - 2 * gx, 1.5; color: ink; opacity: 12% }

            //  ── the demo: no token yet. A banner on what to do, over the example's rooms, which can be played with ──
            group {
                show: hl_demo
                opacity: 1 - st_k
                box { from: 14 * u, 60 * u; size: W - 28 * u, 62 * u; corner: 12 * u; color: mint; opacity: 14% }
                PRound(x: 16.6 * u, y: 62.6 * u, w: W - 33.2 * u, h: 56.8 * u, r: 9.7 * u, s: 5, wd: 1.5 * u, c: mint, a: 0.7, f: 0)
                PIcon(k: 8, cx: 38 * u, cy: 91 * u, lit: 0, c: mint, a: 1, s: 11, f: 0, z: 1)
                text t_demo_title { at: 62 * u, 76 * u; anchor: left center; size: 13.5; weight: 700; width: W - 90 * u; lines: 1; color: mint; family: "Space Grotesk" }
                text t_demo_hint { at: 62 * u, 86 * u; anchor: left top; size: 11.5; weight: 600; width: W - 90 * u; lines: 2; color: ink; family: "Space Grotesk" }
            }
            }
            group {
            opacity: en2 * (1 - st_k)
            move: 0, (1 - en2) * 12 * u
            //  ── the rooms and their tiles ──
            //  One list that scrolls as the shell's own do (the wheel, a drag, the spring they glide with): what it holds is laid out by the logic, in a single piece
            //  as tall as all of it, so everything below is in that piece's own place, from its top (`hl_sc` is how far it has gone). Under the tiles, a zone the
            //  size of the view takes the wheel and the drag; a drag that starts on a tile reaches it too (any zone under the press does), but not in edit mode.
            zone box hl_view_z { from: 0, gtop; size: W, vh }
            on scroll hl_view_z while not sl_open and not st_open { hl_sp: clamp(hl_sp - wheel * 80 * u, 0, most) }
            on press hl_view_z { hl_grab = hl_sp }
            on drag hl_view_z while not hl_editing and mv_i < 0 and rz_i < 0 { hl_sp: clamp(hl_grab - drag.dy, 0, most) }
            group {
              clip box { from: 0, gtop; size: W, vh }
              group {
                move: 0, gtop - hl_sp
                //  a room's head: its name, and after it the temperature and the humidity, each with its sign, when the room has a sensor for them
                for rm in hl_rooms {
                    let hy = rm.yu * u
                    row {
                        at: gx + 4 * u, hy + 4 * u
                        gap: 6 * u
                        align: center
                        show: hy - hl_sc > -40 * u and hy - hl_sc < vh
                        text rm.name { size: 15; weight: 700; color: ink; family: "Space Grotesk" }
                        space 4 * u
                        group { size: 16 * u, 16 * u; show: rm.has_t > 0.5; HUi(k: 4, cx: 8 * u, cy: 8 * u, c: faint, a: 1, s: 431, f: 0, z: 0.62) }
                        text rm.temp { size: 12.5; weight: 600; color: faint; show: rm.has_t > 0.5; family: "Space Grotesk" }
                        space 2 * u
                        group { size: 15 * u, 16 * u; show: rm.has_h > 0.5; HUi(k: 5, cx: 7.5 * u, cy: 8 * u, c: faint, a: 1, s: 441, f: 0, z: 0.58) }
                        text rm.hum { size: 12.5; weight: 600; color: faint; show: rm.has_h > 0.5; family: "Space Grotesk" }
                    }
                }
                for r in hl_items {
                    let held = rz_i == r.index
                    let tcs = if(held, rz_w, r.cs)
                    let trs = if(held, rz_h, r.rs)
                    let cx0 = gx + r.col * (hw + gap)
                    let cy0 = r.yu * u
                    let tww = tcs * hw + (tcs - 1) * gap        // the tile's own size: as many half columns as it takes, and the gaps between them
                    let small = if(tcs <= 1.5, 1, 0)            // half a column: the icon alone, in the middle
                    let thh = trs * th + (trs - 1) * gap
                    let tall = if(trs >= 2, 1, 0)               // two rows or more: the disc at the top, the name and the rest along the bottom
                    let seen = cy0 - hl_sc > -thh and cy0 - hl_sc < vh
                    //  a light shows the slider's value while the slider is on it
                    let bv = if(sl_open and sl_i == r.index, sl_vs, r.bri)
                    //  a light with a colour of its own is lit in it instead of the accent (the card's, while it is chosen there)
                    let live = if(sl_open and sl_i == r.index and sl_ck > 0.5, 1, 0)
                    let kh = if(live > 0.5, sl_hs, r.hu)
                    let ks = if(live > 0.5, sl_ss, r.sa)
                    let kk = if(r.ct > 0.5 and (r.hk > 0.5 or live > 0.5), 1, 0)
                    //  (the colours are drawn a little softer than the light's, as the shell's accents are; a dark one takes a light icon)
                    let kdark = if(kk > 0.5 and 0.3 * (1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1))) + 0.59 * (1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1))) + 0.11 * (1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))) < 0.6, 1, 0)
                    let lit = r.on * r.avail
                    let dx = if(small > 0.5, cx0 + tww / 2, cx0 + mix(33, 36, tall) * u)          // the disc's middle
                    let dy = if(small > 0.5, cy0 + thh / 2, mix(cy0 + thh / 2, cy0 + 36 * u, tall))
                    let carried = if(mv_i == r.index, 1, 0)
                    let under = if(mv_i >= 0 and carried < 0.5 and mv_cx > cx0 and mv_cx < cx0 + tww and mv_cy > cy0 and mv_cy < cy0 + thh, 1, 0)
                    let tx = mix(cx0 + 62 * u, cx0 + 18 * u, tall)                   // where the name starts, and how wide it may be
                    let tmax = tww - mix(if(r.kind == 1, 112, 72), 36, tall) * u
                    let ny = mix(cy0 + thh / 2 - 9 * u, cy0 + thh - if(r.kind == 0 and lit > 0.5, 46, 38) * u, tall)
                    group {
                        opacity: if(r.avail > 0.5, 100%, 45%) * (1 - 0.15 * carried)
                        move: mv_dx * carried, mv_dy * carried
                        zone box hl_tile_z { from: cx0, cy0; size: tww, thh; corner: 14 * u; cursor: pointer; active: seen and sl_k < 0.05 and not hl_editing; label: "{r.name}"; role: toggle; checked: r.on > 0.5 }
                        on press hl_tile_z { hl_grab = hl_sp; emit hl_tap(r.index) }
                        on press right hl_tile_z while r.kind == 0 and r.avail > 0.5 and r.prn < 0.5 { sl_i = r.index; sl_pk = r.pk; sl_dk = r.dk; sl_v = r.bri; sl_dirty = false; sl_col = r.cc; sl_tint = r.ct; sl_ck = r.hk; sl_h = r.hu; sl_s = r.sa; sl_cdirty = false; sl_open = true }
                        on press right hl_tile_z while r.prn > 0.5 { pr_i = r.index; pr_pk = r.pk; pr_dk = r.dk; pr_open = true }
                        on press right hl_tile_z while r.tvr > 0.5 { tv_i = r.index; tv_pk = r.pk; tv_dk = r.dk; tv_tab = 0; tv_open = true }
                        //  the plate: a veil, flushed with the accent while it is on; in edit mode an outline, the accent's while it is pulled
                        box { from: cx0, cy0; size: tww, thh; corner: 14 * u; color: ink; opacity: 7% + 5% * hl_tile_z.hover }
                        box { from: cx0, cy0; size: tww, thh; corner: 14 * u; color: mix(mint, rgb(1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))), kk); opacity: 13% * lit }
                        box { from: cx0, cy0; size: tww, thh; corner: 14 * u; stroke: 1.5 * u; color: if(held or carried > 0.5 or under > 0.5, mint, ink); opacity: hl_ed * if(held or carried > 0.5 or under > 0.5, 90%, 22%) }
                        box { from: cx0, cy0; size: tww, thh; corner: 14 * u; color: mint; opacity: 12% * under }
                        //  the disc: hollow when off, lit and glowing when on (a little larger in a tall tile)
                        body {
                            color: mix(off, mix(mint, rgb(1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))), kk), lit)
                            shadow: 0, 0, 10 * u * lit, 45% * lit, mix(mint, rgb(1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))), kk)
                            rim: 16% * lit
                            ellipse { at: dx, dy; radius: mix(19, 22, tall) * u }
                        }
                        //  the pencil's icon (the default): drawn in strokes, still unless the tile is on or under the pointer
                        group {
                            show: r.custom < 0.5 and r.pk >= 0
                            PIcon(k: max(r.pk, 0), cx: dx, cy: dy, lit: 0, c: mix(ink, if(kdark > 0.5, ink, onmint), lit), a: 1, s: 3 + r.index * 17, f: if(lit > 0.5 or hl_tile_z.hover > 0.5, fr, 0), z: 0.78 + 0.12 * tall)
                        }
                        //  an icon of its own: a white svg, tinted as the Material ones are
                        image r.img { at: dx - (11 + 2 * tall) * u, dy - (11 + 2 * tall) * u; size: (22 + 4 * tall) * u, (22 + 4 * tall) * u; tint: mix(ink, if(kdark > 0.5, ink, onmint), lit); show: r.custom > 0.5 }
                        //  the add-on's own icons, in pencil (tira-led.svg and the rest): still unless the tile is on or under the pointer
                        group {
                            show: r.dk >= 0
                            HDev(k: max(r.dk, 0), cx: dx, cy: dy, c: mix(ink, if(kdark > 0.5, ink, onmint), lit), a: 1, s: 5 + r.index * 13, f: if(lit > 0.5 or hl_tile_z.hover > 0.5, fr, 0), z: 0.92 + 0.15 * tall)
                        }
                        //  the name and how it is
                        text r.name { at: tx, ny; anchor: left center; size: 13.5 + tall; weight: 600; width: tmax; lines: 1; color: ink; show: small < 0.5; family: "Space Grotesk" }
                        text r.sub { at: tx, ny + 19 * u; anchor: left center; size: 11.5; weight: 500; width: tmax; lines: 1; show: small < 0.5; color: if(lit > 0.5, mix(mint, rgb(1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))), kk), faint); family: "Space Grotesk" }
                        //  a light: how bright, along the bottom
                        group {
                            show: r.kind == 0 and lit > 0.5 and small < 0.5
                            let bx = mix(cx0 + 62 * u, cx0 + 18 * u, tall)
                            let bw = mix(tww - 76 * u, tww - 36 * u, tall)
                            //  (the Control Center's little slider, at the foot of a lit light, as the add-on template has it; it boils under the pointer)
                            PSliderMiniTint(x0: bx, y: cy0 + thh - 13 * u, w: bw, lv: bv, h: 8 * u, f: if(hl_tile_z.hover > 0.5 or (sl_open and sl_i == r.index), fr, 0), c: mix(mint, rgb(1 - 0.85 * ks * (1 - clamp(abs(kh * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 2), 0, 1)), 1 - 0.85 * ks * (1 - clamp(2 - abs(kh * 6 - 4), 0, 1))), kk))
                        }
                        //  a printer: the print's progress along the bottom, while one runs
                        group {
                            show: r.prn > 0.5 and r.pp >= 0 and not (r.kind == 0 and lit > 0.5) and small < 0.5
                            let px0 = mix(cx0 + 62 * u, cx0 + 18 * u, tall)
                            let pw0 = mix(tww - if(r.kind == 1, 116, 76) * u, tww - 36 * u, tall)
                            box { from: px0, cy0 + thh - 13 * u; size: pw0, 3 * u; corner: 1.5 * u; color: ink; opacity: 12% }
                            box { from: px0, cy0 + thh - 13 * u; size: max(3 * u, pw0 * r.pp), 3 * u; corner: 1.5 * u; color: mint }
                        }
                        //  a switch: the Control Center's (addon-pencil.plm's PSwitch: grey and hollow off, lit and wider on, the knob stretching as it travels), top right in
                        //  a tall tile; its pencil outline boils while it is on or under the pointer, as the shell's
                        group {
                            show: r.kind == 1 and small < 0.5
                            let sy = mix(cy0 + thh / 2, cy0 + 30 * u, tall)
                            PSwitch(sx: cx0 + tww - 36 * u, sy: sy, on: lit, av: 1, s: 7 + r.index, f: if(lit > 0.5 or hl_tile_z.hover > 0.5, fr, 0))
                        }
                        //  edit mode: the handle in the corner. While it is held its zone covers the panel, so the drag is not lost as the tile grows under it;
                        //  the size it would take, in cells, in the middle of the tile
                        group {
                            opacity: hl_ed
                            ellipse { at: cx0 + tww - 15 * u, cy0 + thh - 15 * u; radius: 11 * u; color: mint; opacity: if(held, 100%, 80% + 20% * hl_grip_z.hover) }
                            HUi(k: 6, cx: cx0 + tww - 15 * u, cy: cy0 + thh - 15 * u, c: onmint, a: 1, s: 451, f: 0, z: 0.5)
                            box { at: cx0 + tww / 2, cy0 + thh / 2; size: 64 * u, 30 * u; corner: 15 * u; color: deep; opacity: if(held, 80%, 0%) }
                            text t_rz { at: cx0 + tww / 2, cy0 + thh / 2; anchor: center; size: 14; weight: 700; color: mint; opacity: if(held, 100%, 0%); family: "Space Grotesk" }
                        }
                        //  edit mode: the tile itself is carried to another place (it follows the pointer; the tile under its middle lights, and it lands there)
                        zone box hl_mv_z { from: cx0, cy0; size: tww, thh; corner: 14 * u; cursor: if(carried > 0.5, grabbing, grab); active: hl_editing and seen and rz_i < 0 and (mv_i < 0 or carried > 0.5); label: "{r.name}" }
                        on press hl_mv_z { mv_i = r.index; mv_dx = 0; mv_dy = 0; mv_cx = cx0 + tww / 2; mv_cy = cy0 + thh / 2 }
                        on drag hl_mv_z while mv_i == r.index { mv_dx = drag.dx; mv_dy = drag.dy; mv_cx = cx0 + tww / 2 + drag.dx; mv_cy = cy0 + thh / 2 + drag.dy }
                        on release hl_mv_z while mv_i == r.index { emit hl_move(r.index * 10000000 + clamp(round(mv_cx / u), 0, 999) * 10000 + clamp(round(mv_cy / u), 0, 9999)); mv_i = -1; mv_dx = 0; mv_dy = 0 }
                        zone box hl_grip_z { at: if(held, W / 2, cx0 + tww - 15 * u), if(held, hl_sc + vh / 2, cy0 + thh - 15 * u); size: if(held, W, 30 * u), if(held, vh, 30 * u); cursor: grab; active: hl_editing and seen and (rz_i < 0 or held); label: "{t_resize} {r.name}" }
                        on press hl_grip_z { rz_w0 = r.cs; rz_h0 = r.rs; rz_w = r.cs; rz_h = r.rs; rz_i = r.index }
                        on drag hl_grip_z while held { rz_w = clamp(rz_w0 + round(drag.dx / (hw + gap)), 1, 2 * cols); rz_h = clamp(rz_h0 + round(drag.dy / (th + gap)), 1, 3) }
                        on release hl_grip_z { rz_i = -1 }
                    }
                }
              }
            }
            //  how far down the list is, when it does not all fit
            box { from: W - 7 * u, gtop + hl_sp / max(content, 1) * vh; size: 3 * u, vh * vh / max(content, vh); corner: 1.5 * u; color: ink; opacity: if(most > 0.5, 25%, 0%) }

            }
            group {
            opacity: en3 * (1 - st_k)
            move: 0, (1 - en3) * 12 * u
            //  ── when there is nothing to show ──
            group {
                show: hl_state == 0 and hl_items.count == 0
                arc { at: W / 2, H / 2 - 18 * u; radius: 14 * u; span: 270deg; width: 3 * u; color: mint; rotate: mod(hl_spin * 260, 360) * 1deg }
                text t_connecting { at: W / 2, H / 2 + 14 * u; anchor: center; size: 13; weight: 600; color: faint; family: "Space Grotesk" }
            }
            group {
                show: hl_state >= 2 and hl_items.count == 0
                HUi(k: if(hl_state == 2, 7, 8), cx: W / 2, cy: H / 2 - 52 * u, c: if(hl_state == 2, alert, mint), a: 1, s: 461, f: fr, z: 1.45)
                text t_title { at: W / 2, H / 2 - 16 * u; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
                text hl_msg { at: W / 2, H / 2 + 4 * u; anchor: center top; size: 12; weight: 500; width: W - 70 * u; align: center; color: faint; family: "Space Grotesk" }
                zone box hl_cfg_z { at: W / 2, H / 2 + 74 * u; size: 210 * u, 36 * u; corner: 18 * u; cursor: pointer; label: t_edit_cfg }
                on press hl_cfg_z { st_open = true }
                body {
                    color: mint
                    shadow: 0, 0, 10 * u, 35% + 15% * hl_cfg_z.hover, mint
                    rim: 16%
                    box { at: W / 2, H / 2 + 74 * u; size: 210 * u, 36 * u; corner: 18 * u }
                }
                text t_edit_cfg { at: W / 2, H / 2 + 74 * u; anchor: center; size: 13.5; weight: 700; color: onmint; family: "Space Grotesk" }
            }
            group {
                show: hl_state == 1 and hl_items.count == 0
                HUi(k: 9, cx: W / 2, cy: H / 2 - 40 * u, c: mint, a: 1, s: 471, f: fr, z: 1.45)
                text t_empty { at: W / 2, H / 2 - 4 * u; anchor: center; size: 15; weight: 700; color: ink; family: "Space Grotesk" }
                text t_empty_hint { at: W / 2, H / 2 + 16 * u; anchor: center top; size: 12; weight: 500; width: W - 70 * u; align: center; color: faint; family: "Space Grotesk" }
            }

            }
            //  ── the settings (the gear): over the tiles, under the cards ──
            group {
                opacity: en2 * st_k
                show: st_k > 0.01
                move: 0, (1 - st_k) * 10 * u
                let stw = W - 28 * u
                //  the tabs (the theme's lit piece under the chosen one), or, on an entity or a room, the way back and its title
                group {
                    show: st_page == 0
                    let tbw2 = stw / 2
                    box { from: 14 * u, 62 * u; size: stw, 32 * u; corner: 16 * u; color: ink; opacity: 7% }
                    PThumb(x: 14 * u + tbw2 / 2 + st_tk * tbw2, y: 78 * u, w: tbw2 - 6 * u, h: 26 * u, rad: 13 * u, th: 32 * u, a: 1)
                    repeat i in 0..2 {
                        text pick(i, t_st_settings, t_st_entities) { at: 14 * u + i * tbw2 + tbw2 / 2, 78 * u; anchor: center; size: 12.5; weight: 700; color: mix(faint, onmint, clamp(1 - abs(st_tk - i), 0, 1)); family: "Space Grotesk" }
                        zone box st_tab_z.$i { from: 14 * u + i * tbw2, 62 * u; size: tbw2, 32 * u; corner: 16 * u; cursor: pointer; label: pick(i, t_st_settings, t_st_entities); role: tab; selected: st_tab == i }
                    }
                    on press st_tab_z.0 { st_tab = 0 }
                    on press st_tab_z.1 { st_tab = 1 }
                }
                group {
                    show: st_page > 0
                    ellipse { at: 30 * u, 78 * u; radius: 15 * u; color: ink; opacity: 8% + 10% * st_back_z.hover }
                    HUi(k: 27, cx: 30 * u, cy: 78 * u, c: mix(ink, mint, st_back_z.hover), a: 1, s: 801, f: if(st_back_z.hover > 0.5, fr, 0), z: 0.62)
                    zone box st_back_z { at: 30 * u, 78 * u; size: 32 * u, 32 * u; corner: 16 * u; cursor: pointer; label: t_st_back }
                    on press st_back_z { emit st_back }
                    text st_title { at: 54 * u, 78 * u; anchor: left center; size: 15; weight: 700; width: W - 80 * u; lines: 1; color: ink; family: "Space Grotesk" }
                }
                //  the page: one list that scrolls, everything in it placed by the logic
                let stv = max(H - 104 * u - 10 * u, 1)
                let st_most = max(0, st_content * u - stv)
                //  (above the placed field, and below it: the field itself is left to the shell)
                let fld_t = clamp(104 * u + (st_fy + 18) * u - st_sp, 104 * u, 104 * u + stv)
                let fld_b = clamp(fld_t + 38 * u, 104 * u, 104 * u + stv)
                zone box st_view_z { from: 0, 104 * u; size: W, if(st_fa >= 0, fld_t - 104 * u, stv) }
                zone box st_view_b { from: 0, fld_b; size: W, 104 * u + stv - fld_b; active: st_fa >= 0 }
                on scroll st_view_z { st_sp: clamp(st_sp - wheel * 60 * u, 0, st_most) }
                on scroll st_view_b { st_sp: clamp(st_sp - wheel * 60 * u, 0, st_most) }
                box { from: W - 7 * u, 104 * u + st_sp / max(st_content * u, 1) * stv; size: 3 * u, stv * stv / max(st_content * u, stv); corner: 1.5 * u; color: ink; opacity: if(st_most > 0.5, 25%, 0%) }
                group {
                  clip box { from: 0, 104 * u; size: W, stv }
                  group {
                    move: 0, 104 * u - st_sp
                    //  the rows
                    for r in st_rows {
                        let rx = 14 * u + r.x * u
                        let ry = r.y * u
                        let rw = if(r.w > 0, r.w * u, stw)
                        let rh = r.h * u
                        let act = if(r.index == st_fa, 1, 0)
                        //  a section's title
                        text r.label { at: rx + 2 * u, ry + rh / 2; anchor: left center; size: 11.5; weight: 700; color: mint; show: r.kind == 0; family: "Space Grotesk" }
                        //  a note
                        text r.label { at: rx + 2 * u, ry; anchor: left top; size: 11; weight: 500; width: rw - 4 * u; lines: 3; color: faint; show: r.kind == 4; family: "Space Grotesk" }
                        //  a field: its label above, its box, what it says (or its placeholder); the one the shell's field is on shows the text being written, and a caret
                        group {
                            show: r.kind == 1
                            text r.label { at: rx + 2 * u, ry + 8 * u; anchor: left center; size: 11.5; weight: 600; width: rw; lines: 1; color: faint; family: "Space Grotesk" }
                            box { from: rx, ry + 18 * u; size: rw, 38 * u; corner: 12 * u; color: ink; opacity: 7% + 4% * st_fz.hover + 5% * act }
                            PRound(x: rx + 1.6 * u, y: ry + 19.6 * u, w: rw - 3.2 * u, h: 34.8 * u, r: 10.5 * u, s: 900 + r.index, wd: 1.3 * u, c: mix(faint, mint, act), a: 0.3 + 0.5 * act, f: if(act > 0.5 and field_kb, fr, 0))
                            text r.val { at: rx + 14 * u, ry + 37 * u; anchor: left center; size: 13.5; weight: 500; width: rw - 28 * u; lines: 1; color: ink; show: act < 0.5 and r.on > 0.5; family: "Space Grotesk" }
                            text r.ph { at: rx + 14 * u, ry + 37 * u; anchor: left center; size: 13.5; weight: 500; width: rw - 28 * u; lines: 1; color: faint; opacity: 60%; show: r.on < 0.5 and (act < 0.5 or not st_fvon); family: "Space Grotesk" }
                        }
                        //  (the field's label and a margin round it too: the shell's field is put there while the pointer is still on its way, so it is already the shell's
                        //  when the pointer reaches the box and stops; a compositor only finds what is under a pointer when it moves)
                        zone box st_fz { from: rx - 6 * u, ry - 3 * u; size: rw + 12 * u, 62 * u; corner: 12 * u; cursor: pointer; active: r.kind == 1 and act < 0.5 and st_k > 0.9; label: "{r.label}" }
                        on enter st_fz while not field_kb { emit st_fld(r.index) }
                        on press st_fz { emit st_fld(r.index) }
                        //  a suggestion under a field: what Home Assistant calls it, and its id
                        group {
                            show: r.kind == 5
                            box { from: rx, ry; size: rw, rh - 2 * u; corner: 10 * u; color: mix(ink, mint, st_sg_z.hover); opacity: 5% + 8% * st_sg_z.hover }
                            text r.label { at: rx + 12 * u, ry + rh / 2 - 7 * u; anchor: left center; size: 12.5; weight: 600; width: rw - 24 * u; lines: 1; color: ink; family: "Space Grotesk" }
                            text r.sub { at: rx + 12 * u, ry + rh / 2 + 8 * u; anchor: left center; size: 10.5; weight: 500; width: rw - 24 * u; lines: 1; color: faint; family: "Space Grotesk" }
                        }
                        zone box st_sg_z { from: rx, ry; size: rw, rh - 2 * u; corner: 10 * u; cursor: pointer; active: r.kind == 5 and st_k > 0.9; label: "{r.label}" }
                        on press st_sg_z { emit st_do(r.index) }
                        //  a button: a pill, plain, in the accent, or for deleting (red, filled once it asks again)
                        group {
                            show: r.kind == 6
                            let lit = if(r.tone == 1, 1, 0)
                            box { from: rx, ry; size: rw, rh; corner: rh / 2; color: if(r.tone >= 2, alert, ink); opacity: if(r.tone == 0, 9% + 9% * st_bt_z.hover, if(r.tone == 2, 12% + 10% * st_bt_z.hover, 0%)) }
                            body {
                                color: if(r.tone == 3, alert, mint)
                                opacity: if(r.tone == 1 or r.tone == 3, 100%, 0%)
                                shadow: 0, 0, 10 * u * lit, 30% + 15% * st_bt_z.hover, mint
                                rim: 16%
                                box { from: rx, ry; size: rw, rh; corner: rh / 2 }
                            }
                            text r.label { at: rx + rw / 2, ry + rh / 2; anchor: center; size: 12.5; weight: 700; width: rw - 16 * u; lines: 1; align: center; color: if(r.tone == 1 or r.tone == 3, onmint, if(r.tone == 2, alert, mix(ink, mint, st_bt_z.hover))); family: "Space Grotesk" }
                        }
                        zone box st_bt_z { from: rx, ry; size: rw, rh; corner: rh / 2; cursor: pointer; active: r.kind == 6 and st_k > 0.9; label: "{r.label}" }
                        on press st_bt_z { emit st_do(r.index) }
                    }
                    //  the switches: a name, and the Control Center's switch at the right; the whole row is the button
                    for w in st_sws {
                        let wy = w.y * u
                        box { from: 14 * u, wy; size: stw, 40 * u; corner: 12 * u; color: ink; opacity: 4% * st_sw_z.hover }
                        text w.label { at: 16 * u, wy + 20 * u; anchor: left center; size: 13; weight: 600; width: stw - 60 * u; lines: 1; color: ink; family: "Space Grotesk" }
                        PSwitch(sx: W - 35 * u, sy: wy + 20 * u, on: if(w.on > 0.5, 1, 0), av: 1, s: 950 + w.index, f: if(st_sw_z.hover > 0.5, fr, 0))
                        zone box st_sw_z { from: 14 * u, wy; size: stw, 40 * u; corner: 12 * u; cursor: pointer; active: st_k > 0.9; label: "{w.label}"; role: toggle; checked: w.on > 0.5 }
                        on press st_sw_z { emit st_sw(w.index) }
                    }
                    //  the text being written in the field the shell's field is on, measured for the caret
                    group {
                        show: st_fa >= 0
                        text st_fv { at: 14 * u + st_fx * u + 14 * u, st_fy * u + 37 * u; anchor: left center; size: 13.5; weight: 500; width: st_fw * u - 28 * u; lines: 1; color: ink; measure: stf; family: "Space Grotesk" }
                        box { from: 14 * u + st_fx * u + 15 * u + min(stf.width, st_fw * u - 30 * u), st_fy * u + 28 * u; size: 2 * u, 18 * u; color: mint; opacity: if(field_kb, 1, 0) * (0.55 + 0.45 * sin(time * 6)) }
                    }
                    //  a choice among a few (the language, a tile's kind, its room, a printer): the theme's lit piece under the chosen one
                    for c in st_chips {
                        let chx = 14 * u + c.x * u
                        let chy = c.y * u
                        let chw = c.w * u
                        box { from: chx, chy; size: chw, 30 * u; corner: 15 * u; color: ink; opacity: if(c.sel > 0.5, 0%, 8% + 8% * st_ch_z.hover) }
                        group {
                            show: c.sel > 0.5
                            PThumb(x: chx + chw / 2, y: chy + 15 * u, w: chw, h: 30 * u, rad: 15 * u, th: 30 * u, a: 1)
                        }
                        text c.label { at: chx + chw / 2, chy + 15 * u; anchor: center; size: 12; weight: 700; width: chw - 10 * u; lines: 1; align: center; color: if(c.sel > 0.5, onmint, mix(ink, mint, st_ch_z.hover)); family: "Space Grotesk" }
                        zone box st_ch_z { from: chx, chy; size: chw, 30 * u; corner: 15 * u; cursor: pointer; active: st_k > 0.9; label: "{c.label}"; role: tab; selected: c.sel > 0.5 }
                        on press st_ch_z { emit st_chip(c.index) }
                    }
                    //  the icons to choose from: the pencil's and the add-on's own
                    for c in st_icons {
                        let icx = 14 * u + c.x * u
                        let icy = c.y * u
                        box { from: icx, icy; size: 44 * u, 44 * u; corner: 12 * u; color: if(c.sel > 0.5, mint, ink); opacity: if(c.sel > 0.5, 18%, 6% + 8% * st_ic_z.hover) }
                        group {
                            show: c.sel > 0.5
                            PRound(x: icx + 1.5 * u, y: icy + 1.5 * u, w: 41 * u, h: 41 * u, r: 10.5 * u, s: 1000 + c.index, wd: 1.4 * u, c: mint, a: 0.8, f: 0)
                        }
                        group {
                            show: c.pk >= 0
                            PIcon(k: max(c.pk, 0), cx: icx + 22 * u, cy: icy + 22 * u, lit: 0, c: if(c.sel > 0.5, mint, ink), a: 1, s: 1100 + c.index * 7, f: if(st_ic_z.hover > 0.5, fr, 0), z: 0.8)
                        }
                        group {
                            show: c.dk >= 0
                            HDev(k: max(c.dk, 0), cx: icx + 22 * u, cy: icy + 22 * u, c: if(c.sel > 0.5, mint, ink), a: 1, s: 1200 + c.index * 7, f: if(st_ic_z.hover > 0.5, fr, 0), z: 0.95)
                        }
                        zone box st_ic_z { from: icx, icy; size: 44 * u, 44 * u; corner: 12 * u; cursor: pointer; active: st_k > 0.9; role: tab; selected: c.sel > 0.5 }
                        on press st_ic_z { emit st_icon(c.index) }
                    }
                    //  the entities' list: a room's head, and its tiles (each opened to edit with a click)
                    for e in st_ents {
                        let ey = e.y * u
                        group {
                            show: e.kind == 0
                            text e.name { at: 16 * u, ey + 17 * u; anchor: left center; size: 14.5; weight: 700; width: stw - 60 * u; lines: 1; color: ink; family: "Space Grotesk" }
                            text e.sub { at: 16 * u, ey + 33 * u; anchor: left center; size: 10.5; weight: 500; width: stw - 60 * u; lines: 1; color: faint; family: "Space Grotesk" }
                        }
                        group {
                            show: e.kind == 1
                            box { from: 14 * u, ey; size: stw, 48 * u; corner: 12 * u; color: ink; opacity: 6% + 6% * st_en_z.hover }
                            PIcon(k: max(e.pk, 0), cx: 38 * u, cy: ey + 24 * u, lit: 0, c: mix(ink, mint, st_en_z.hover), a: 1, s: 1300 + e.index * 7, f: if(st_en_z.hover > 0.5, fr, 0), z: 0.72)
                            text e.name { at: 62 * u, ey + 16 * u; anchor: left center; size: 13; weight: 700; width: stw - 100 * u; lines: 1; color: ink; family: "Space Grotesk" }
                            text e.sub { at: 62 * u, ey + 33 * u; anchor: left center; size: 10.5; weight: 500; width: stw - 100 * u; lines: 1; color: faint; family: "Space Grotesk" }
                        }
                        let chy2 = ey + if(e.kind == 0, 21, 24) * u
                        PLn(ax: W - 38 * u, ay: chy2 - 6 * u, bx: W - 32 * u, by: chy2, s: 1400 + e.index, wd: 1.8 * u, c: mix(faint, mint, st_en_z.hover), a: 1, f: if(st_en_z.hover > 0.5, fr, 0))
                        PLn(ax: W - 32 * u, ay: chy2, bx: W - 38 * u, by: chy2 + 6 * u, s: 1450 + e.index, wd: 1.8 * u, c: mix(faint, mint, st_en_z.hover), a: 1, f: if(st_en_z.hover > 0.5, fr, 0))
                        zone box st_en_z { from: 14 * u, ey; size: stw, if(e.kind == 0, 42, 48) * u; corner: 12 * u; cursor: pointer; active: st_k > 0.9; label: "{e.name}" }
                        on press st_en_z { emit st_ent(e.index) }
                    }
                  }
                }
            }
            //  ── the brightness slider: a card over the panel, which a click outside it, its X or a right click shuts ──
            group {
                opacity: sl_k
                let cw = min(W - 40 * u, 400 * u)
                let ch = if(sl_col > 0.5, 298, 186) * u          // (taller with the colours)
                let cl = (W - cw) / 2
                let ct = (H - ch) / 2 + 10 * u * (1 - sl_k)
                let tl = cl + 22 * u
                let tw2 = cw - 44 * u
                let ty = ct + 98 * u
                let kx = tl + 17 * u + (tw2 - 34 * u) * sl_vs
                let lk = if(sl_tint > 0.5 and sl_ck > 0.5, 1, 0)      // the light's own colour, known, and asked for ("tint"): the disc and the track take it
                let ldark = if(lk > 0.5 and 0.3 * (1 - 0.85 * sl_ss * (1 - clamp(abs(sl_hs * 6 - 3) - 1, 0, 1))) + 0.59 * (1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 2), 0, 1))) + 0.11 * (1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 4), 0, 1))) < 0.6, 1, 0)
                //  first the veil over the tiles, which shuts it (declared before the card, so the card's zones win over it)
                //  (over all of Vitreus's glass, not only the content: past it by the glass's margin at the sides and the foot (14) and the title bar on top (38),
                //  both in Vitreus's `cu`, 1.5525, with the glass's own corner, `rc`: 26, or 7 with the square themes, Retro and Cyber, times its `u`, 1.35)
                let sl_gm = 14 * 1.5525
                let sl_gt = 38 * 1.5525
                let sl_gr = (26 - 19 * if(look == 1 or look == 3, 1, 0)) * 1.35
                box { from: -sl_gm, -sl_gt; size: W + 2 * sl_gm, H + sl_gt + sl_gm; corner: sl_gr; color: deep; opacity: 45% }
                zone box sl_scrim_z { from: -sl_gm, -sl_gt; size: W + 2 * sl_gm, H + sl_gt + sl_gm; corner: sl_gr }
                on press sl_scrim_z { sl_open = false }
                on press right sl_scrim_z { sl_open = false }
                body {
                    color: card
                    shadow: 0, 10 * u, 30 * u, 45%, deep
                    rim: 10%
                    box { from: cl, ct; size: cw, ch; corner: 20 * u }
                }
                zone box sl_card_z { from: cl, ct; size: cw, ch; corner: 20 * u }
                on press right sl_card_z { sl_open = false }
                //  the light: its disc, its name, the value
                body {
                    color: mix(off, mix(mint, rgb(1 - 0.85 * sl_ss * (1 - clamp(abs(sl_hs * 6 - 3) - 1, 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 2), 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 4), 0, 1))), lk), if(sl_vs > 0.004, 1, 0))
                    shadow: 0, 0, 10 * u * if(sl_vs > 0.004, 1, 0), 45%, mix(mint, rgb(1 - 0.85 * sl_ss * (1 - clamp(abs(sl_hs * 6 - 3) - 1, 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 2), 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 4), 0, 1))), lk)
                    rim: 16%
                    ellipse { at: cl + 42 * u, ct + 42 * u; radius: 20 * u }
                }
                group {
                    show: not sl_custom and sl_pk >= 0
                    PIcon(k: max(sl_pk, 0), cx: cl + 42 * u, cy: ct + 42 * u, lit: 0, c: if(sl_vs > 0.004 and ldark < 0.5, onmint, ink), a: 1, s: 21, f: fr, z: 0.8)
                }
                for r in hl_items {
                    image r.img { at: cl + 31 * u, ct + 31 * u; size: 22 * u, 22 * u; tint: if(sl_vs > 0.004 and ldark < 0.5, onmint, ink); show: sl_custom and r.index == sl_i }
                }
                group {
                    show: sl_dk >= 0
                    HDev(k: max(sl_dk, 0), cx: cl + 42 * u, cy: ct + 42 * u, c: if(sl_vs > 0.004 and ldark < 0.5, onmint, ink), a: 1, s: 481, f: fr, z: 0.92)
                }
                text sl_name { at: cl + 72 * u, ct + 34 * u; anchor: left center; size: 15; weight: 700; width: cw - 170 * u; lines: 1; color: ink; family: "Space Grotesk" }
                text t_brightness { at: cl + 72 * u, ct + 53 * u; anchor: left center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk" }
                text number(sl_vs * 100, 0, " %") { at: cl + cw - 58 * u, ct + 42 * u; anchor: right center; size: 24; weight: 700; color: ink; family: "Space Grotesk" }
                ellipse { at: cl + cw - 30 * u, ct + 28 * u; radius: 13 * u; color: ink; opacity: 8% + 10% * sl_x_z.hover }
                HUi(k: 10, cx: cl + cw - 30 * u, cy: ct + 28 * u, c: mix(faint, ink, sl_x_z.hover), a: 1, s: 491, f: if(sl_x_z.hover > 0.5, fr, 0), z: 0.62)
                zone box sl_x_z { at: cl + cw - 30 * u, ct + 28 * u; size: 28 * u, 28 * u; corner: 14 * u; cursor: pointer; label: t_close }
                on press sl_x_z { sl_open = false }
                //  the track: the Control Center's slider, coloured in with the accent (or the light's colour); it boils under the pointer and while it is dragged
                PSliderTint(x0: tl, y: ty, w: tw2, lv: sl_vs, h: 18 * u, f: if(sl_tr_z.hover > 0.5 or sl_dirty, fr, 0), c: mix(mint, rgb(1 - 0.85 * sl_ss * (1 - clamp(abs(sl_hs * 6 - 3) - 1, 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 2), 0, 1)), 1 - 0.85 * sl_ss * (1 - clamp(2 - abs(sl_hs * 6 - 4), 0, 1))), lk))
                zone box sl_tr_z { from: tl - 6 * u, ty - 22 * u; size: tw2 + 12 * u, 44 * u; corner: 22 * u; cursor: pointer; label: "{t_brightness}: {sl_name}"; role: slider; value: "{sl_vs * 100} %" }
                on press sl_tr_z { sl_v = clamp((local.x - tl) / tw2, 0, 1); sl_dirty = true }
                on drag sl_tr_z { sl_v = clamp((local.x - tl) / tw2, 0, 1); sl_dirty = true }
                on scroll sl_card_z { sl_v = clamp(sl_v + wheel * 0.05, 0, 1); sl_dirty = true }
                on release sl_tr_z { emit hl_bri(sl_v); sl_dirty = false }
                //  a pause in the moving sends it too, so the light follows the finger without a request per frame
                on still sl_v for 280ms while sl_open and sl_dirty { emit hl_bri(sl_v); sl_dirty = false }
                //  the quick ones: off, a quarter, half, three quarters, full
                let pw = (tw2 - 4 * 8 * u) / 5
                repeat i in 0..5 {
                    let px = tl + i * (pw + 8 * u)
                    let pv = i * 0.25
                    let here = abs(sl_v - pv) < 0.01
                    zone box sl_p_z.$i { from: px, ct + 136 * u; size: pw, 30 * u; corner: 15 * u; cursor: pointer; label: "{t_brightness}: {i * 25} %" }
                    on press sl_p_z.$i { sl_v = pv; emit hl_bri(pv); sl_dirty = false }
                    box { from: px, ct + 136 * u; size: pw, 30 * u; corner: 15 * u; color: mint; opacity: if(here, 100%, 0%) }
                    box { from: px, ct + 136 * u; size: pw, 30 * u; corner: 15 * u; color: ink; opacity: if(here, 0%, 8% + 8% * sl_p_z.$i.hover) }
                    text t_off { at: px + pw / 2, ct + 151 * u; anchor: center; size: 12; weight: 700; color: if(here, onmint, ink); show: i == 0; family: "Space Grotesk" }
                    text pick(i, "", "25 %", "50 %", "75 %", "100 %") { at: px + pw / 2, ct + 151 * u; anchor: center; size: 12; weight: 700; color: if(here, onmint, ink); show: i > 0; family: "Space Grotesk" }
                }
                //  the colour, for a light that has one: a rainbow to drag along, and a row of made ones (two whites, then around the wheel). Choosing one on a
                //  light that is off turns it on, at full brightness.
                group {
                    show: sl_col > 0.5
                    box { from: tl, ct + 184 * u; size: tw2, 1.5; color: ink; opacity: 10% }
                    text t_color { at: tl, ct + 204 * u; anchor: left center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk" }
                    let hy = ct + 230 * u
                    let hx = tl + 11 * u + (tw2 - 22 * u) * sl_hs
                    body {
                        gradient: tl, hy to tl + tw2, hy, #ff2626, #ffff26, #26ff26, #26ffff, #2626ff, #ff26ff, #ff2626          // lint: colour the hue bar: the colours a light can be, to pick one from
                        rim: 16%
                        box { from: tl, hy - 11 * u; size: tw2, 22 * u; corner: 11 * u }
                    }
                    //  in pencil, as the sliders: a crooked outline round it, and a ring for a knob around the hue (faded while the colour is a white, which has none)
                    PRound(x: tl, y: hy - 11 * u, w: tw2, h: 22 * u, r: 11 * u, s: 87, wd: 1.5 * u, c: ink, a: 0.55, f: if(sl_hue_z.hover > 0.5 or sl_cdirty, fr, 0))
                    PCir(cx: hx, cy: hy, rad: 13 * u, s: 89, wd: 1.6 * u, c: ink, a: if(sl_ck > 0.5 and sl_s > 0.05, 0.95, 0.45), gapk: -1, f: if(sl_hue_z.hover > 0.5 or sl_cdirty, fr, 0))
                    ellipse { at: hx, hy; radius: 8 * u; color: rgb(0.15 + 0.85 * clamp(abs(sl_hs * 6 - 3) - 1, 0, 1), 0.15 + 0.85 * clamp(2 - abs(sl_hs * 6 - 2), 0, 1), 0.15 + 0.85 * clamp(2 - abs(sl_hs * 6 - 4), 0, 1)); opacity: if(sl_ck > 0.5 and sl_s > 0.05, 100%, 40%) }
                    zone box sl_hue_z { from: tl - 6 * u, hy - 18 * u; size: tw2 + 12 * u, 36 * u; corner: 18 * u; cursor: pointer; label: "{t_color}: {sl_name}"; role: slider; value: "{sl_hs * 360}" }
                    on press sl_hue_z { sl_h = clamp((local.x - tl - 11 * u) / (tw2 - 22 * u), 0, 1); sl_s = 1; sl_ck = 1; sl_v = if(sl_v < 0.01, 1, sl_v); sl_cdirty = true }
                    on drag sl_hue_z { sl_h = clamp((local.x - tl - 11 * u) / (tw2 - 22 * u), 0, 1); sl_s = 1; sl_cdirty = true }
                    on release sl_hue_z { emit hl_color(round(sl_h * 360) * 1000 + round(sl_s * 100)); sl_cdirty = false }
                    //  a pause in the dragging sends it too, as the brightness does
                    on still sl_h for 280ms while sl_open and sl_cdirty { emit hl_color(round(sl_h * 360) * 1000 + round(sl_s * 100)); sl_cdirty = false }
                    //  the made ones: hue and saturation, each drawn in the colour it sends
                    let sgap = (tw2 - 28 * u) / 9
                    repeat i in 0..10 {
                        let sx = tl + 14 * u + i * sgap
                        let sy = ct + 270 * u
                        let ph = pick(i, 0, 0.09, 0, 0.07, 0.14, 0.33, 0.5, 0.64, 0.76, 0.89)
                        let ps = pick(i, 0, 0.5, 1, 1, 1, 1, 1, 1, 1, 1)
                        let here = sl_ck > 0.5 and abs(sl_s - ps) < 0.02 and (ps < 0.01 or abs(sl_h - ph) < 0.01)
                        zone box sl_sw_z.$i { at: sx, sy; size: 32 * u, 32 * u; corner: 16 * u; cursor: pointer; label: "{t_color} {i + 1}" }
                        on press sl_sw_z.$i { sl_h = ph; sl_s = ps; sl_ck = 1; sl_v = if(sl_v < 0.01, 1, sl_v); emit hl_color(round(ph * 360) * 1000 + round(ps * 100)); sl_cdirty = false }
                        box { at: sx, sy; size: 34 * u, 34 * u; corner: 17 * u; stroke: 2 * u; color: ink; opacity: if(here, 90%, 12% * sl_sw_z.$i.hover) }
                        body {
                            color: rgb(1 - 0.85 * ps * (1 - clamp(abs(ph * 6 - 3) - 1, 0, 1)), 1 - 0.85 * ps * (1 - clamp(2 - abs(ph * 6 - 2), 0, 1)), 1 - 0.85 * ps * (1 - clamp(2 - abs(ph * 6 - 4), 0, 1)))
                            rim: 16%
                            ellipse { at: sx, sy; radius: (12 + if(here, 0, 1) * sl_sw_z.$i.hover) * u }
                        }
                    }
                }
            }

            //  ── the printer's card: over the panel like the slider's, shut by a click outside it, its X or a right click ──
            group {
                opacity: pr_k
                show: pr_k > 0.01
                let pcw = min(W - 28 * u, 460 * u)
                let pch = 320 * u
                let pcl = (W - pcw) / 2
                let pct = (H - pch) / 2 + 10 * u * (1 - pr_k)
                let plit = if(pr_st == 1, 1, 0)
                //  the veil, as the slider's (over all of Vitreus's glass)
                let pr_gm = 14 * 1.5525
                let pr_gt = 38 * 1.5525
                let pr_gr = (26 - 19 * if(look == 1 or look == 3, 1, 0)) * 1.35
                box { from: -pr_gm, -pr_gt; size: W + 2 * pr_gm, H + pr_gt + pr_gm; corner: pr_gr; color: deep; opacity: 45% }
                zone box pr_scrim_z { from: -pr_gm, -pr_gt; size: W + 2 * pr_gm, H + pr_gt + pr_gm; corner: pr_gr }
                on press pr_scrim_z { pr_open = false }
                on press right pr_scrim_z { pr_open = false }
                body {
                    color: card
                    shadow: 0, 10 * u, 30 * u, 45%, deep
                    rim: 10%
                    box { from: pcl, pct; size: pcw, pch; corner: 20 * u }
                }
                zone box pr_card_z { from: pcl, pct; size: pcw, pch; corner: 20 * u }
                on press right pr_card_z { pr_open = false }
                //  the head: the printer's disc (lit while it prints), the job and its state, and the X
                body {
                    color: mix(off, mint, plit)
                    shadow: 0, 0, 10 * u * plit, 45%, mint
                    rim: 16%
                    ellipse { at: pcl + 42 * u, pct + 42 * u; radius: 20 * u }
                }
                group {
                    show: not pr_custom and pr_pk >= 0
                    PIcon(k: max(pr_pk, 0), cx: pcl + 42 * u, cy: pct + 42 * u, lit: 0, c: mix(ink, onmint, plit), a: 1, s: 23, f: fr * plit, z: 0.8)
                }
                for r in hl_items {
                    image r.img { at: pcl + 31 * u, pct + 31 * u; size: 22 * u, 22 * u; tint: mix(ink, onmint, plit); show: pr_custom and r.index == pr_i }
                }
                group {
                    show: pr_dk >= 0
                    HDev(k: max(pr_dk, 0), cx: pcl + 42 * u, cy: pct + 42 * u, c: mix(ink, onmint, plit), a: 1, s: 501, f: fr * plit, z: 0.92)
                }
                text pr_task { at: pcl + 72 * u, pct + 33 * u; anchor: left center; size: 15; weight: 700; width: pcw - 130 * u; lines: 1; color: ink; family: "Space Grotesk" }
                row {
                    at: pcl + 72 * u, pct + 46 * u
                    gap: 6 * u
                    align: center
                    ellipse { radius: 3.5 * u; color: pick(pr_st, faint, mint, ink, mint, alert, faint, alert) }
                    text pr_status { size: 11.5; weight: 600; color: pick(pr_st, faint, mint, ink, mint, alert, faint, alert); family: "Space Grotesk" }
                }
                ellipse { at: pcl + pcw - 30 * u, pct + 28 * u; radius: 13 * u; color: ink; opacity: 8% + 10% * pr_x_z.hover }
                HUi(k: 10, cx: pcl + pcw - 30 * u, cy: pct + 28 * u, c: mix(faint, ink, pr_x_z.hover), a: 1, s: 511, f: if(pr_x_z.hover > 0.5, fr, 0), z: 0.62)
                zone box pr_x_z { at: pcl + pcw - 30 * u, pct + 28 * u; size: 28 * u, 28 * u; corner: 14 * u; cursor: pointer; label: t_close }
                on press pr_x_z { pr_open = false }
                //  the picture: the model's cover, or the camera (live, a frame every two seconds; a click on it opens it full size in the browser)
                let pis = 140 * u
                let pix = pcl + 20 * u
                let piy = pct + 84 * u
                box { from: pix, piy; size: pis, pis; corner: 14 * u; color: ink; opacity: 6% }
                HUi(k: 11, cx: pix + pis / 2, cy: piy + pis / 2, c: faint, a: if(pr_has_pic, 0, 0.6), s: 521, f: 0, z: 1.45)
                group {
                    clip box { from: pix, piy; size: pis, pis; corner: 14 * u }
                    for p in pr_pic { image p.img { at: pix, piy; size: pis, pis; fit: cover; show: pr_has_pic } }
                }
                group {
                    show: pr_cam and pr_has_pic
                    box { from: pix + 8 * u, piy + pis - 30 * u; size: 70 * u, 22 * u; corner: 11 * u; color: deep; opacity: 75% }
                    ellipse { at: pix + 20 * u, piy + pis - 19 * u; radius: 3.5 * u; color: alert }
                    text t_live { at: pix + 29 * u, piy + pis - 19 * u; anchor: left center; size: 10; weight: 700; color: ink; family: "Space Grotesk" }
                    ellipse { at: pix + pis - 19 * u, piy + 19 * u; radius: 12 * u; color: deep; opacity: 60% + 20% * pr_pic_z.hover }
                    HUi(k: 12, cx: pix + pis - 19 * u, cy: piy + 19 * u, c: ink, a: 1, s: 531, f: if(pr_pic_z.hover > 0.5, fr, 0), z: 0.52)
                }
                zone box pr_pic_z { from: pix, piy; size: pis, pis; corner: 14 * u; cursor: pointer; active: pr_cam and pr_has_pic; label: t_open_cam }
                on press pr_pic_z { emit pr_act(4) }
                //  beside it: the progress, its bar, the time left, when it started and when it ends
                let prx = pix + pis + 18 * u
                let prw = pcl + pcw - 20 * u - prx
                text t_progress { at: prx, piy + 8 * u; anchor: left center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk" }
                text pr_pct { at: prx, piy + 34 * u; anchor: left center; size: 30; weight: 700; color: ink; family: "Space Grotesk" }
                box { from: prx, piy + 58 * u; size: prw, 6 * u; corner: 3 * u; color: ink; opacity: 10% }
                body {
                    gradient: prx, piy to prx + prw, piy, mintlo, minthi
                    shadow: 0, 0, 8 * u * plit, 30%, mint
                    box { from: prx, piy + 58 * u; size: max(6 * u, prw * pr_progs), 6 * u; corner: 3 * u }
                }
                HUi(k: 13, cx: prx + 8 * u, cy: piy + 90 * u, c: faint, a: 1, s: 541, f: 0, z: 0.6)
                text pr_left { at: prx + 24 * u, piy + 90 * u; anchor: left center; size: 12.5; weight: 600; width: prw - 24 * u; lines: 1; color: ink; family: "Space Grotesk" }
                HUi(k: 14, cx: prx + 8 * u, cy: piy + 114 * u, c: faint, a: 1, s: 551, f: 0, z: 0.6)
                text pr_start { at: prx + 24 * u, piy + 114 * u; anchor: left center; size: 12.5; weight: 600; width: prw - 24 * u; lines: 1; color: ink; family: "Space Grotesk" }
                HUi(k: 15, cx: prx + 8 * u, cy: piy + 138 * u, c: faint, a: 1, s: 561, f: 0, z: 0.6)
                text pr_end { at: prx + 24 * u, piy + 138 * u; anchor: left center; size: 12.5; weight: 600; width: prw - 24 * u; lines: 1; color: ink; family: "Space Grotesk" }
                //  the buttons: pause or resume, stop (pressed twice: the first asks), and the camera
                let pbw = (pcw - 40 * u - 2 * 8 * u) / 3
                let pby = pct + pch - 54 * u
                let pb0 = pr_has_btn and (pr_st == 1 or pr_st == 2)
                let pb1 = pr_has_btn and (pr_st == 1 or pr_st == 2 or pr_st == 5)
                repeat i in 0..3 {
                    let bx = pcl + 20 * u + i * (pbw + 8 * u)
                    let on = pick(i, if(pb0, 1, 0), if(pb1, 1, 0), if(pr_has_cam, 1, 0))
                    let hot = pick(i, 0, if(pr_arm, 1, 0), if(pr_cam, 1, 0))      // filled: stop armed (red), the camera on (the accent)
                    group {
                        opacity: if(on > 0.5, 100%, 35%)
                        box { from: bx, pby; size: pbw, 36 * u; corner: 18 * u; color: ink; opacity: (8% + 8% * pr_b_z.$i.hover) * (1 - hot) }
                        box { from: bx, pby; size: pbw, 36 * u; corner: 18 * u; color: if(i == 1, alert, mint); opacity: 90% * hot }
                        //  the icon and the word, each centred on the button's middle line by itself (a row would centre the icon font's tall line box, not its
                        //  glyph, and the pair came out low), and side by side centred as one: the word's width is measured
                        let lw = pbm.$i.width
                        let gx0 = bx + pbw / 2 - (lw + 23 * u) / 2
                        HUi(k: pick(i + 3 * if(pr_st == 2, 1, 0), 16, 17, 18, 19, 17, 18), cx: gx0 + 8.5 * u, cy: pby + 18 * u, c: if(hot > 0.5, onmint, if(i == 1, alert, ink)), a: 1, s: 571 + i * 10, f: if(pr_b_z.$i.hover > 0.5, fr, 0), z: 0.62)
                        text pick(i, t_b0, t_b1, t_b2) { at: gx0 + 23 * u, pby + 18 * u; anchor: left center; size: 12.5; weight: 700; color: if(hot > 0.5, onmint, if(i == 1, alert, ink)); measure: pbm.$i; family: "Space Grotesk" }
                        zone box pr_b_z.$i { from: bx, pby; size: pbw, 36 * u; corner: 18 * u; cursor: pointer; active: on > 0.5; label: pick(i, "{t_pause} / {t_resume}", "{t_stop}", "{t_camera}") }
                    }
                }
                on press pr_b_z.0 { emit pr_act(if(pr_st == 2, 1, 0)) }
                on press pr_b_z.1 while pr_arm { emit pr_act(2); pr_arm = false }
                on press pr_b_z.1 while not pr_arm { pr_arm = true }
                on press pr_b_z.2 { toggle pr_cam }
            }

            //  ── an Apple TV's card: over the panel like the others, shut by a click outside it, its X, a right click or Escape ──
            group {
                opacity: tv_k
                show: tv_k > 0.01
                //  all of it a little smaller when the panel is not tall enough for it (`v` is its `u`)
                let tsc = min(1, (H - 16 * u) / ((mix(324, 330, tv_tk) - if(tv_has_rm, 0, 38)) * u))
                let v = u * tsc
                let tcw = min(W - 28 * u, 460 * v)
                let tch = (mix(324, 330, tv_tk) - if(tv_has_rm, 0, 38)) * v
                let tcl = (W - tcw) / 2
                let tct = (H - tch) / 2 + 10 * v * (1 - tv_k)
                let tlit = if(tv_st == 2, 1, 0)
                let tv_gm = 14 * 1.5525
                let tv_gt = 38 * 1.5525
                let tv_gr = (26 - 19 * if(look == 1 or look == 3, 1, 0)) * 1.35
                box { from: -tv_gm, -tv_gt; size: W + 2 * tv_gm, H + tv_gt + tv_gm; corner: tv_gr; color: deep; opacity: 45% }
                zone box tv_scrim_z { from: -tv_gm, -tv_gt; size: W + 2 * tv_gm, H + tv_gt + tv_gm; corner: tv_gr }
                on press tv_scrim_z { tv_open = false }
                on press right tv_scrim_z { tv_open = false }
                body {
                    color: card
                    shadow: 0, 10 * v, 30 * v, 45%, deep
                    rim: 10%
                    box { from: tcl, tct; size: tcw, tch; corner: 20 * v }
                }
                zone box tv_card_z { from: tcl, tct; size: tcw, tch; corner: 20 * v }
                on press right tv_card_z { tv_open = false }
                //  the head: its disc (lit while it plays), its name, how it is and in which app, the power and the X
                body {
                    color: mix(off, mint, tlit)
                    shadow: 0, 0, 10 * v * tlit, 45%, mint
                    rim: 16%
                    ellipse { at: tcl + 42 * v, tct + 42 * v; radius: 20 * v }
                }
                group {
                    show: not tv_custom and tv_pk >= 0
                    PIcon(k: max(tv_pk, 0), cx: tcl + 42 * v, cy: tct + 42 * v, lit: 0, c: mix(ink, onmint, tlit), a: 1, s: 25, f: fr * tlit, z: 0.8 * tsc)
                }
                for r in hl_items {
                    image r.img { at: tcl + 31 * v, tct + 31 * v; size: 22 * v, 22 * v; tint: mix(ink, onmint, tlit); show: tv_custom and r.index == tv_i }
                }
                group {
                    show: tv_dk >= 0
                    HDev(k: max(tv_dk, 0), cx: tcl + 42 * v, cy: tct + 42 * v, c: mix(ink, onmint, tlit), a: 1, s: 601, f: fr * tlit, z: 0.92 * tsc)
                }
                text tv_name { at: tcl + 72 * v, tct + 33 * v; anchor: left center; size: 15 * tsc; weight: 700; width: tcw - 170 * v; lines: 1; color: ink; family: "Space Grotesk" }
                row {
                    at: tcl + 72 * v, tct + 46 * v
                    gap: 6 * v
                    align: center
                    ellipse { radius: 3.5 * v; color: pick(tv_st, faint, ink, mint, ink) }
                    text tv_status { size: 11.5 * tsc; weight: 600; width: tcw - 170 * v; lines: 1; color: pick(tv_st, faint, ink, mint, ink); family: "Space Grotesk" }
                }
                body {
                    color: mix(ink, mint, if(tv_st > 0, 1, 0))
                    opacity: if(tv_st > 0, 90%, 8% + 10% * tv_pw_z.hover)
                    ellipse { at: tcl + tcw - 64 * v, tct + 28 * v; radius: 13 * v }
                }
                HUi(k: 20, cx: tcl + tcw - 64 * v, cy: tct + 28 * v, c: if(tv_st > 0, onmint, mix(faint, ink, tv_pw_z.hover)), a: 1, s: 611, f: if(tv_pw_z.hover > 0.5, fr, 0), z: 0.6 * tsc)
                zone box tv_pw_z { at: tcl + tcw - 64 * v, tct + 28 * v; size: 28 * v, 28 * v; corner: 14 * v; cursor: pointer; label: t_power; role: toggle; checked: tv_st > 0 }
                on press tv_pw_z { emit tv_cmd(10) }
                ellipse { at: tcl + tcw - 30 * v, tct + 28 * v; radius: 13 * v; color: ink; opacity: 8% + 10% * tv_x_z.hover }
                HUi(k: 10, cx: tcl + tcw - 30 * v, cy: tct + 28 * v, c: mix(faint, ink, tv_x_z.hover), a: 1, s: 621, f: if(tv_x_z.hover > 0.5, fr, 0), z: 0.62 * tsc)
                zone box tv_x_z { at: tcl + tcw - 30 * v, tct + 28 * v; size: 28 * v, 28 * v; corner: 14 * v; cursor: pointer; label: t_close }
                on press tv_x_z { tv_open = false }
                on key Escape while tv_open { tv_open = false }
                //  the tabs: what is playing, and the remote (only with a remote entity)
                let tbw = (tcw - 40 * v) / 2
                group {
                    show: tv_has_rm
                    box { from: tcl + 20 * v, tct + 78 * v; size: tcw - 40 * v, 32 * v; corner: 16 * v; color: ink; opacity: 7% }
                    //  the lit piece under the chosen tab: the theme's (a glowing pill, or the Proxy theme's slanted slab), sliding between the two
                    PThumb(x: tcl + 20 * v + tbw / 2 + tv_tk * tbw, y: tct + 94 * v, w: tbw - 6 * v, h: 26 * v, rad: 13 * v, th: 32 * v, a: 1)
                    repeat i in 0..2 {
                        HUi(k: pick(i, 14, 21), cx: tcl + 20 * v + i * tbw + tbw / 2 - tbm.$i.width / 2 - 2 * v, cy: tct + 94 * v, c: mix(faint, onmint, clamp(1 - abs(tv_tk - i), 0, 1)), a: 1, s: 631 + i * 10, f: 0, z: 0.58 * tsc)
                        text pick(i, t_tab0, t_tab1) { at: tcl + 20 * v + i * tbw + tbw / 2 - tbm.$i.width / 2 + 10 * v, tct + 94 * v; anchor: left center; size: 12.5 * tsc; weight: 700; color: mix(faint, onmint, clamp(1 - abs(tv_tk - i), 0, 1)); measure: tbm.$i; family: "Space Grotesk" }
                        zone box tv_tab_z.$i { from: tcl + 20 * v + i * tbw, tct + 78 * v; size: tbw, 32 * v; corner: 16 * v; cursor: pointer; label: pick(i, t_tab0, t_tab1); role: tab; selected: tv_tab == i }
                    }
                    on press tv_tab_z.0 { tv_tab = 0 }
                    on press tv_tab_z.1 { tv_tab = 1 }
                }
                let cy0 = tct + if(tv_has_rm, 124, 80) * v
                //  ── what is playing ──
                group {
                    opacity: 1 - tv_tk
                    show: tv_tk < 0.99
                    let as = 116 * v
                    let ax = tcl + 20 * v
                    box { from: ax, cy0; size: as, as; corner: 14 * v; color: ink; opacity: 6% }
                    //  no artwork (many apps give the Apple TV none, and Home Assistant has none to give): the app's name on a wash of the accent instead
                    group {
                        show: not tv_has_pic
                        body {
                            gradient: ax, cy0 to ax + as, cy0 + as, mix(card, mint, 0.28), mix(card, mint, 0.06)
                            rim: 10%
                            box { from: ax, cy0; size: as, as; corner: 14 * v }
                        }
                        HUi(k: 22, cx: ax + as / 2, cy: cy0 + as / 2 - if(tv_app_on, 14, 0) * v, c: mint, a: if(tv_has_appic, 0, 0.85), s: 651, f: 0, z: 1.1 * tsc)
                        //  the app's icon, rounded as on the Apple TV's home screen
                        group {
                            show: tv_has_appic
                            clip box { from: ax + as / 2 - 28 * v, cy0 + as / 2 - 44 * v; size: 56 * v, 56 * v; corner: 13 * v }
                            for p in tv_appic { image p.img { at: ax + as / 2 - 28 * v, cy0 + as / 2 - 44 * v; size: 56 * v, 56 * v; fit: cover } }
                        }
                        text tv_app { at: ax + as / 2, cy0 + as / 2 + if(tv_has_appic, 30, 20) * v; anchor: center; size: 14 * tsc; weight: 700; width: as - 16 * v; lines: 1; align: center; color: ink; show: tv_app_on; family: "Space Grotesk" }
                    }
                    group {
                        clip box { from: ax, cy0; size: as, as; corner: 14 * v }
                        for p in tv_pic { image p.img { at: ax, cy0; size: as, as; fit: cover; show: tv_has_pic } }
                    }
                    let mx = ax + as + 18 * v
                    let mw = tcl + tcw - 20 * v - mx
                    text tv_title { at: mx, cy0 + 4 * v; anchor: left top; size: 16 * tsc; weight: 700; width: mw; lines: 2; color: ink; family: "Space Grotesk" }
                    text tv_sub { at: mx, cy0 + 62 * v; anchor: left center; size: 12.5 * tsc; weight: 600; width: mw; lines: 1; color: faint; family: "Space Grotesk" }
                    group {
                        show: tv_has_prog
                        box { from: mx, cy0 + as - 28 * v; size: mw, 5 * v; corner: 2.5 * v; color: ink; opacity: 10% }
                        body {
                            gradient: mx, cy0 to mx + mw, cy0, mintlo, minthi
                            shadow: 0, 0, 8 * v * tlit, 30%, mint
                            box { from: mx, cy0 + as - 28 * v; size: max(5 * v, mw * tv_progs), 5 * v; corner: 2.5 * v }
                        }
                        text tv_pos { at: mx, cy0 + as - 8 * v; anchor: left center; size: 11 * tsc; weight: 600; color: faint; family: "Space Grotesk" }
                        text tv_rem { at: mx + mw, cy0 + as - 8 * v; anchor: right center; size: 11 * tsc; weight: 600; color: faint; family: "Space Grotesk" }
                    }
                    //  the transport: volume down, previous, play/pause (lit), next, volume up
                    let ty0 = cy0 + as + 44 * v
                    repeat i in 0..5 {
                        let bx = tcl + tcw / 2 + (i - 2) * 70 * v
                        let code = pick(i, 9, 11, 7, 12, 8)
                        let big = if(i == 2, 1, 0)
                        let live = if(i == 0 or i == 4 or tv_st > 0, 1, 0)
                        group {
                            opacity: if(live > 0.5, 100%, 35%)
                            ellipse { at: bx, ty0; radius: 21 * v; color: ink; opacity: if(tv_fl == code, 24%, 8% + 8% * tv_m_z.$i.hover) * (1 - big) }
                            body {
                                color: mint
                                shadow: 0, 0, 12 * v, 35% + 15% * tv_m_z.$i.hover, mint
                                rim: 16%
                                opacity: big
                                ellipse { at: bx, ty0; radius: (27 + if(tv_fl == 7, -2, 1) * tv_m_z.$i.hover) * v }
                            }
                            HUi(k: pick(i + if(i == 2 and tv_st == 2, 3, 0), 23, 24, 19, 25, 26, 16), cx: bx, cy: ty0, c: if(big > 0.5, onmint, ink), a: 1, s: 661 + i * 10, f: if(tv_m_z.$i.hover > 0.5, fr, 0), z: (22 + 8 * big) / 26 * tsc)
                            zone box tv_m_z.$i { at: bx, ty0; size: (44 + 12 * big) * v, (44 + 12 * big) * v; corner: (22 + 6 * big) * v; cursor: pointer; active: live > 0.5 and tv_tk < 0.5; label: pick(i, t_voldown, t_prev, t_playpause, t_next, t_volup) }
                        }
                        on press tv_m_z.$i { emit tv_cmd(code); tv_fl = code }
                    }
                }
                //  ── the remote: laid out as the Siri Remote, on its side: the clickpad, and beside it its buttons in two columns (back and TV, play/pause and
                //  the volume's rocker, mute under them) ──
                group {
                    opacity: tv_tk
                    show: tv_tk > 0.01 and tv_has_rm
                    let qr = 80 * v
                    let rl = tcl + tcw / 2 - 149 * v
                    let qx = rl + qr
                    let qy = cy0 + qr + 2 * v
                    //  the clickpad: a dark round pad, its four edges and its middle; the wheel over it moves up and down
                    zone box tv_pad_z { at: qx, qy; size: 2 * qr, 2 * qr; corner: qr }
                    body {
                        color: deep
                        opacity: 70%
                        rim: 8%
                        ellipse { at: qx, qy; radius: qr }
                    }
                    repeat k in 0..4 {
                        let ddx = pick(k, 0, 0, -1, 1)
                        let ddy = pick(k, -1, 1, 0, 0)
                        //  the edge, lit under the pointer and when pressed
                        arc { at: qx, qy; radius: 56 * v; span: 48deg; width: 40 * v; rotate: pick(k, 0, 180, 270, 90) * 1deg; color: ink; opacity: if(tv_fl == k, 22%, 9% * tv_d_z.$k.hover) }
                        ellipse { at: qx + ddx * 64 * v, qy + ddy * 64 * v; radius: 3 * v; color: ink; opacity: if(tv_fl == k, 100%, 40% + 40% * tv_d_z.$k.hover) }
                        zone box tv_d_z.$k { from: pick(k, qx - 55 * v, qx - 55 * v, qx - qr, qx + 30 * v), pick(k, qy - qr, qy + 30 * v, qy - 45 * v, qy - 45 * v); size: pick(k, 110 * v, 110 * v, qr - 30 * v, qr - 30 * v), pick(k, qr - 30 * v, qr - 30 * v, 90 * v, 90 * v); cursor: pointer; active: tv_tk > 0.5; label: pick(k, t_up, t_down, t_left, t_right) }
                    }
                    repeat k in 0..4 {
                        on press tv_d_z.$k { emit tv_cmd(k); tv_fl = k }
                        on scroll tv_d_z.$k { emit tv_cmd(if(wheel > 0, 0, 1)); tv_fl = if(wheel > 0, 0, 1) }
                    }
                    on scroll tv_pad_z { emit tv_cmd(if(wheel > 0, 0, 1)); tv_fl = if(wheel > 0, 0, 1) }
                    //  the middle: a click selects, held it is a long press
                    body {
                        color: ink
                        opacity: if(tv_fl == 4 or tv_fl == 15, 26%, 10% + 6% * tv_ok_z.hover)
                        rim: 10%
                        ellipse { at: qx, qy; radius: 29 * v }
                    }
                    zone box tv_ok_z { at: qx, qy; size: 58 * v, 58 * v; corner: 29 * v; cursor: pointer; label: t_select }
                    on press tv_ok_z { tv_hd = false; tv_fl = 4 }
                    on hold tv_ok_z for 600ms { tv_hd = true; tv_fl = 15; emit tv_cmd(15) }
                    on release tv_ok_z while not tv_hd { emit tv_cmd(4) }
                    on scroll tv_ok_z { emit tv_cmd(if(wheel > 0, 0, 1)); tv_fl = if(wheel > 0, 0, 1) }
                    //  the buttons: first column back, play/pause, mute; second TV (held: the control centre) and the volume's rocker, + over −
                    let ca = rl + 2 * qr + 36 * v + 22 * v
                    let cb = ca + 58 * v
                    repeat i in 0..4 {
                        let bx = if(i == 1, cb, ca)
                        let by = qy + pick(i, -54, -54, 0, 54) * v
                        let code = pick(i, 5, 6, 7, 17)
                        ellipse { at: bx, by; radius: 22 * v; color: ink; opacity: if(tv_fl == code or (i == 1 and tv_fl == 16), 26%, 10% + 8% * tv_r_z.$i.hover) }
                        HUi(k: pick(i, 27, 28, 29, 30), cx: bx, cy: by, c: ink, a: 1, s: 711 + i * 10, f: if(tv_r_z.$i.hover > 0.5, fr, 0), z: 0.82 * tsc)
                        zone box tv_r_z.$i { at: bx, by; size: 44 * v, 44 * v; corner: 22 * v; cursor: pointer; active: tv_tk > 0.5; label: pick(i, t_back, t_home, t_playpause, t_mute) }
                    }
                    on press tv_r_z.0 { emit tv_cmd(5); tv_fl = 5 }
                    on press tv_r_z.1 { tv_hd = false; tv_fl = 6 }
                    on hold tv_r_z.1 for 600ms { tv_hd = true; tv_fl = 16; emit tv_cmd(16) }
                    on release tv_r_z.1 while not tv_hd { emit tv_cmd(6) }
                    on press tv_r_z.2 { emit tv_cmd(7); tv_fl = 7 }
                    on press tv_r_z.3 { emit tv_cmd(17); tv_fl = 17 }
                    box { from: cb - 22 * v, qy - 22 * v; size: 44 * v, 98 * v; corner: 22 * v; color: ink; opacity: 10% }
                    repeat i in 0..2 {
                        let code = pick(i, 8, 9)
                        box { from: cb - 22 * v, qy - 22 * v + i * 49 * v; size: 44 * v, 49 * v; corner: 22 * v; color: ink; opacity: if(tv_fl == code, 18%, 8% * tv_v_z.$i.hover) }
                        HUi(k: pick(i, 31, 32), cx: cb, cy: qy + i * 54 * v, c: ink, a: 1, s: 761 + i * 10, f: if(tv_v_z.$i.hover > 0.5, fr, 0), z: 0.75 * tsc)
                        zone box tv_v_z.$i { from: cb - 22 * v, qy - 22 * v + i * 49 * v; size: 44 * v, 49 * v; corner: 22 * v; cursor: pointer; active: tv_tk > 0.5; label: pick(i, t_volup, t_voldown) }
                        on press tv_v_z.$i { emit tv_cmd(code); tv_fl = code }
                    }
                    box { at: cb, qy + 27 * v; size: 22 * v, 1.5 * v; color: ink; opacity: 14% }
                    text t_kb { at: tcl + tcw / 2, cy0 + 186 * v; anchor: center; size: 11 * tsc; weight: 600; width: tcw - 40 * v; lines: 1; align: center; color: faint; family: "Space Grotesk" }
                }
                //  the keyboard, while the remote is showing (the card has it then)
                on key Up while tv_open and tv_tab == 1 { emit tv_cmd(0); tv_fl = 0 }
                on key Down while tv_open and tv_tab == 1 { emit tv_cmd(1); tv_fl = 1 }
                on key Left while tv_open and tv_tab == 1 { emit tv_cmd(2); tv_fl = 2 }
                on key Right while tv_open and tv_tab == 1 { emit tv_cmd(3); tv_fl = 3 }
                on key Return while tv_open and tv_tab == 1 { emit tv_cmd(4); tv_fl = 4 }
                on key BackSpace while tv_open and tv_tab == 1 { emit tv_cmd(5); tv_fl = 5 }
                on key space while tv_open and tv_tab == 1 { emit tv_cmd(7); tv_fl = 7 }
            }
        }
    }
}
